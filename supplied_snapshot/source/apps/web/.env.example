# ==============================================================================
# CareerTWiN Web Application Environment Template
# ==============================================================================
# IMPORTANT: Variable names only with BLANK values (or safety defaults).
# NEVER place secret keys, passwords, or live customer tokens in this file.

# Supabase Authentication & Database Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Staging Environment Verification Configuration
CAREERTWIN_STAGING_SUPABASE_URL=
CAREERTWIN_STAGING_PUBLISHABLE_KEY=
CAREERTWIN_STAGING_TEST_PASSWORD=

# Safety Enforcement: External Email Suppression
# Must be set to 'true' in all non-production and staging verification environments
CAREERTWIN_DRY_RUN_EMAIL=true

# Application URL & Port Configuration
PORT=3000
NEXT_PUBLIC_URL=http://localhost:3000

# Model Provider Integration Gateway
GEMINI_API_KEY=

# Sourcing External Integration
CRUSTDATA_API_KEY=

# Context Engine Integration (Research QA Proxy)
# Feature flag: set to 'true' to enable the /api/employer/research-qa route
NEXT_PUBLIC_ENABLE_RESEARCH_QA=false
ENABLE_RESEARCH_QA=false
# Base URL where the Context Engine FastAPI service is running
WORKBYLINE_ENGINE_URL=http://127.0.0.1:8000
# Scoped internal service token for server-to-server authentication
WORKBYLINE_INTERNAL_SERVICE_KEY=
# Workspace ID containing indexed public research documents
WORKBYLINE_RESEARCH_WORKSPACE_ID=
# Set to 'true' to return mocked responses when provider keys are missing
MOCK_RESEARCH_QA_PROVIDER=false

# External Email Gateway (Strictly suppressed when CAREERTWIN_DRY_RUN_EMAIL=true)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
