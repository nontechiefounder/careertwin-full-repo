diff --git a/apps/web/lib/engineConfig.js b/apps/web/lib/engineConfig.js
new file mode 100644
index 0000000..249c399
--- /dev/null
+++ b/apps/web/lib/engineConfig.js
@@ -0,0 +1,254 @@
+/**
+ * Context Engine Configuration & Server-Owned Workspace Mapping
+ * Enforces strict fail-closed configuration, multi-tenant workspace separation,
+ * and upstream response contract validation for Research QA.
+ */
+
+const ALLOWED_STATUSES = [
+  'GROUNDED',
+  'AMBIGUOUS',
+  'DISAGREEMENT',
+  'INSUFFICIENT_EVIDENCE',
+  'UNVERIFIED_STATUS',
+];
+
+const ALLOWED_PROVENANCE = [
+  'LIVE_LOCAL_RETRIEVAL',
+  'LIVE_MODEL_SYNTHESIS',
+  'BLOCKED_PENDING_KEY_ROTATION',
+  'STATIC_EVALUATION',
+];
+
+/**
+ * Validates that context engine configuration is explicitly set and non-empty.
+ * Fails closed if missing, empty, or whitespace-only.
+ */
+export function validateEngineConfig() {
+  const rawUrl = process.env.WORKBYLINE_ENGINE_URL;
+  const rawKey = process.env.WORKBYLINE_INTERNAL_SERVICE_KEY;
+
+  if (!rawUrl || typeof rawUrl !== 'string' || !rawUrl.trim()) {
+    return {
+      ok: false,
+      status: 503,
+      code: 'ENGINE_CONFIG_MISSING',
+      message: 'Context engine URL is not configured (WORKBYLINE_ENGINE_URL is required).',
+    };
+  }
+
+  const trimmedUrl = rawUrl.trim();
+  if (!trimmedUrl.startsWith('http://') && !trimmedUrl.startsWith('https://')) {
+    return {
+      ok: false,
+      status: 503,
+      code: 'ENGINE_CONFIG_INVALID',
+      message: 'Context engine URL must be a valid HTTP or HTTPS address.',
+    };
+  }
+
+  if (!rawKey || typeof rawKey !== 'string' || !rawKey.trim()) {
+    return {
+      ok: false,
+      status: 503,
+      code: 'ENGINE_CONFIG_MISSING',
+      message: 'Context engine service key is not configured (WORKBYLINE_INTERNAL_SERVICE_KEY is required).',
+    };
+  }
+
+  return {
+    ok: true,
+    engineBaseUrl: trimmedUrl.replace(/\/+$/, ''),
+    engineServiceKey: rawKey.trim(),
+  };
+}
+
+/**
+ * Server-owned registry mapping V2 organizations and hiring runs to isolated engine workspaces.
+ * Never accepts client-supplied workspace IDs.
+ */
+export function resolveEngineContext(orgId, hiringRunId, clientRoleId = null) {
+  if (!orgId || typeof orgId !== 'string' || !orgId.trim()) {
+    return {
+      ok: false,
+      status: 400,
+      code: 'ORG_CONTEXT_REQUIRED',
+      message: 'Organization context must be verified before accessing research engine.',
+    };
+  }
+
+  const cleanOrgId = orgId.trim();
+
+  // 1. Check dynamic environment mapping (JSON formatted)
+  let dynamicMappings = {};
+  if (process.env.WORKBYLINE_ENGINE_MAPPINGS) {
+    try {
+      dynamicMappings = JSON.parse(process.env.WORKBYLINE_ENGINE_MAPPINGS);
+    } catch {
+      console.error('[EngineConfig] Malformed WORKBYLINE_ENGINE_MAPPINGS JSON in environment');
+    }
+  }
+
+  // 2. Built-in registered tenant mappings
+  const BUILTIN_MAPPINGS = {
+    // Readily Pilot Organization
+    'org_pilot_readily': {
+      workspaceId: 'ws_readily_pilot',
+      defaultRoleId: 'role_readily_eng',
+      companyName: 'Readily Health',
+      corpusScope: 'PUBLIC_RESEARCH',
+    },
+    // Nosnia AI Organization
+    'org_nosnia': {
+      workspaceId: 'ws_nosnia_pilot',
+      defaultRoleId: 'role_nosnia_ai',
+      companyName: 'Nosnia AI',
+      corpusScope: 'TENANT_PRIVATE',
+    },
+    // Default Demonstration / Staging Organization
+    'org_default': {
+      workspaceId: 'ws_8b9eb121caea4a55',
+      defaultRoleId: 'role_default_eng',
+      companyName: 'WorkByLine Pilot',
+      corpusScope: 'PUBLIC_RESEARCH',
+    },
+    // Test Tenant A & B for Cross-Tenant Verification
+    'org_tenant_alpha': {
+      workspaceId: 'ws_alpha_corp',
+      defaultRoleId: 'role_alpha_lead',
+      companyName: 'Alpha Corp',
+      corpusScope: 'TENANT_PRIVATE',
+    },
+    'org_tenant_beta': {
+      workspaceId: 'ws_beta_corp',
+      defaultRoleId: 'role_beta_lead',
+      companyName: 'Beta Corp',
+      corpusScope: 'TENANT_PRIVATE',
+    },
+  };
+
+  const mapping = dynamicMappings[cleanOrgId] || BUILTIN_MAPPINGS[cleanOrgId];
+
+  if (!mapping) {
+    return {
+      ok: false,
+      status: 403,
+      code: 'UNMAPPED_WORKSPACE',
+      message: `No context engine workspace is mapped for organization '${cleanOrgId}'.`,
+    };
+  }
+
+  const resolvedWorkspaceId = mapping.workspaceId || mapping.workspace_id;
+  const resolvedRoleId = mapping.defaultRoleId || mapping.role_id;
+  const companyName = mapping.companyName || mapping.company_name || 'Organization';
+  const corpusScope = mapping.corpusScope || mapping.corpus_scope || 'TENANT_PRIVATE';
+
+  // 3. Reject client role conflict if supplied
+  if (clientRoleId && clientRoleId !== resolvedRoleId) {
+    return {
+      ok: false,
+      status: 400,
+      code: 'ROLE_CONTEXT_CONFLICT',
+      message: `Client-supplied role_id '${clientRoleId}' conflicts with server-authorized role '${resolvedRoleId}'.`,
+    };
+  }
+
+  return {
+    ok: true,
+    workspaceId: resolvedWorkspaceId,
+    roleId: resolvedRoleId,
+    companyName,
+    corpusScope,
+  };
+}
+
+/**
+ * Validates upstream engine response strictly against declared contracts.
+ * Rejects object-valued answers, unknown statuses, and malformed citations.
+ * Enforces citation grounding requirements.
+ */
+export function validateEngineResponse(engineData) {
+  if (!engineData || typeof engineData !== 'object' || Array.isArray(engineData)) {
+    return {
+      ok: false,
+      status: 502,
+      code: 'MALFORMED_ENGINE_RESPONSE',
+      message: 'Upstream context engine returned a non-object payload.',
+    };
+  }
+
+  // 1. Answer must be a string
+  if (typeof engineData.answer !== 'string' || !engineData.answer.trim()) {
+    return {
+      ok: false,
+      status: 502,
+      code: 'INVALID_ANSWER_TYPE',
+      message: 'Upstream engine answer must be a valid non-empty string.',
+    };
+  }
+
+  // 2. Status enum validation
+  let status = engineData.status;
+  if (!status || !ALLOWED_STATUSES.includes(status)) {
+    return {
+      ok: false,
+      status: 502,
+      code: 'INVALID_ENGINE_STATUS',
+      message: `Upstream engine returned unsupported status: '${status}'.`,
+    };
+  }
+
+  // 3. Citation structure and URL scheme sanitation
+  const rawCitations = Array.isArray(engineData.citations) ? engineData.citations : [];
+  const validCitations = [];
+
+  for (const c of rawCitations) {
+    if (!c || typeof c !== 'object') continue;
+    if (!c.span_id || typeof c.span_id !== 'string') continue;
+    if (!c.quote || typeof c.quote !== 'string' || !c.quote.trim()) continue;
+
+    // Validate URL scheme if present (reject javascript:, file:, data:)
+    let safeUrl = null;
+    if (c.source_url && typeof c.source_url === 'string') {
+      const trimmedUrl = c.source_url.trim();
+      if (trimmedUrl.startsWith('https://') || trimmedUrl.startsWith('http://')) {
+        safeUrl = trimmedUrl;
+      }
+    }
+
+    validCitations.push({
+      span_id: c.span_id.trim(),
+      quote: c.quote.trim(),
+      filename: typeof c.filename === 'string' ? c.filename : 'source_document.md',
+      locator: typeof c.locator === 'string' ? c.locator : 'OFFSET:0',
+      source_url: safeUrl,
+    });
+  }
+
+  // 4. Citation Grounding Contract: GROUNDED responses MUST have supporting citations
+  if (status === 'GROUNDED' && validCitations.length === 0) {
+    status = 'INSUFFICIENT_EVIDENCE';
+  }
+
+  // 5. Strict boolean validation for has_validation_errors (never use Boolean("false"))
+  const hasValidationErrors =
+    engineData.has_validation_errors === true ||
+    engineData.has_validation_errors === 'true';
+
+  // 6. Execution provenance validation (do not default unknown provenance to live execution)
+  let executionProvenance = 'UNVERIFIED_PROVENANCE';
+  if (engineData.execution_provenance && ALLOWED_PROVENANCE.includes(engineData.execution_provenance)) {
+    executionProvenance = engineData.execution_provenance;
+  }
+
+  return {
+    ok: true,
+    data: {
+      answer: engineData.answer.trim(),
+      status,
+      citations: validCitations,
+      has_validation_errors: hasValidationErrors,
+      latency_ms: typeof engineData.latency_ms === 'number' ? engineData.latency_ms : null,
+      execution_provenance: executionProvenance,
+    },
+  };
+}
