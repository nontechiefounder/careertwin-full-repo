+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import { POST } from '@/app/api/employer/research-qa/route';
+import { requireUser, getVerifiedOrgMembership } from '@/lib/serverAuth';
+
+vi.mock('@/lib/serverAuth', () => ({
+  requireUser: vi.fn(),
+  getVerifiedOrgMembership: vi.fn(),
+}));
+
+describe('/api/employer/research-qa API Route', () => {
+  const originalEnv = process.env;
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+    process.env = { ...originalEnv };
+    process.env.NEXT_PUBLIC_ENABLE_RESEARCH_QA = 'true';
+    global.fetch = vi.fn();
+  });
+
+  afterEach(() => {
+    process.env = originalEnv;
+  });
+
+  it('1. Rejects request with 403 when feature flag is disabled', async () => {
+    process.env.NEXT_PUBLIC_ENABLE_RESEARCH_QA = 'false';
+    delete process.env.ENABLE_RESEARCH_QA;
+
+    const req = new Request('http://localhost:3000/api/employer/research-qa', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ question: 'What is Readily?' }),
+    });
+
+    const res = await POST(req);
+    expect(res.status).toBe(403);
+    const data = await res.json();
+    expect(data.error).toBe('RESEARCH_QA_DISABLED');
+  });
+
+  it('2. Rejects request with 401 when user is unauthenticated', async () => {
+    requireUser.mockResolvedValue({
+      errorResponse: new Response(JSON.stringify({ error: 'Unauthorized' }), { status: 401 }),
+      user: null,
+      supabase: null,
+    });
+
+    const req = new Request('http://localhost:3000/api/employer/research-qa', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ question: 'What is Readily?' }),
+    });
+
+    const res = await POST(req);
+    expect(res.status).toBe(401);
+  });
+
+  it('3. Rejects empty question with 400 Bad Request', async () => {
+    const mockSupabase = {
+      from: vi.fn().mockReturnValue({
+        select: vi.fn().mockReturnThis(),
+        eq: vi.fn().mockReturnThis(),
+        single: vi.fn().mockResolvedValue({ data: { id: 'run-1', org_id: 'org-1' }, error: null }),
+      }),
+    };
+    requireUser.mockResolvedValue({
+      errorResponse: null,
+      user: { id: 'user-1' },
+      supabase: mockSupabase,
+    });
+
+    const req = new Request('http://localhost:3000/api/employer/research-qa', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ question: '   ' }),
+    });
+
+    const res = await POST(req);
+    expect(res.status).toBe(400);
+    const data = await res.json();
+    expect(data.error).toBe('Question is required');
+  });
+
+  it('4. Rejects foreign hiring run access with 404 (database-backed check)', async () => {
+    const mockSupabase = {
+      from: vi.fn().mockReturnValue({
+        select: vi.fn().mockReturnThis(),
+        eq: vi.fn().mockReturnThis(),
+        single: vi.fn().mockResolvedValue({ data: null, error: { message: 'Not found' } }),
+      }),
+    };
+    requireUser.mockResolvedValue({
+      errorResponse: null,
+      user: { id: 'user-1' },
+      supabase: mockSupabase,
+    });
+
+    const req = new Request('http://localhost:3000/api/employer/research-qa', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ hiring_run_id: 'foreign-run-999', question: 'What is Readily?' }),
+    });
+
+    const res = await POST(req);
+    expect(res.status).toBe(404);
+  });
+
+  it('5. Successfully forwards authorized query to Context Engine and returns sanitized grounded answer', async () => {
+    const mockSupabase = {
+      from: vi.fn().mockReturnValue({
+        select: vi.fn().mockReturnThis(),
+        eq: vi.fn().mockReturnThis(),
+        single: vi.fn().mockResolvedValue({ data: { id: 'run-1', org_id: 'org-1' }, error: null }),
+      }),
+    };
+    requireUser.mockResolvedValue({
+      errorResponse: null,
+      user: { id: 'user-1' },
+      supabase: mockSupabase,
+    });
+    getVerifiedOrgMembership.mockResolvedValue({
+      membership_role: 'admin',
+      membership_status: 'active',
+    });
+
+    global.fetch.mockResolvedValue({
+      ok: true,
+      status: 200,
+      json: async () => ({
+        answer: 'Readily Health provides AI-powered medical review infrastructure.',
+        status: 'GROUNDED',
+        has_validation_errors: false,
+        latency_ms: 120,
+        execution_provenance: 'LIVE_LOCAL_RETRIEVAL',
+        citations: [
+          {
+            span_id: 'span_21724ca5f4fd4688',
+            quote: 'Readily Health provides AI-powered medical review infrastructure.',
+            filename: '02_product_public_context.md',
+            locator: 'TEXT_LINE:14-16',
+            source_url: 'https://readilyhealth.com/product',
+          },
+        ],
+      }),
+    });
+
+    const req = new Request('http://localhost:3000/api/employer/research-qa', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        hiring_run_id: 'run-1',
+        question: 'What is Readily Health?',
+      }),
+    });
+
+    const res = await POST(req);
+    expect(res.status).toBe(200);
+    const data = await res.json();
+    expect(data.status).toBe('GROUNDED');
+    expect(data.answer).toContain('Readily Health provides');
+    expect(data.disclaimer).toContain('PUBLIC RESEARCH / NOT EMPLOYER-APPROVED');
+    expect(data.citations).toHaveLength(1);
+    expect(data.citations[0].quote).toBe('Readily Health provides AI-powered medical review infrastructure.');
+  });
+
+  it('6. Handles Context Engine 503 service unavailable gracefully', async () => {
+    const mockSupabase = {
+      from: vi.fn().mockReturnValue({
+        select: vi.fn().mockReturnThis(),
+        eq: vi.fn().mockReturnThis(),
+        single: vi.fn().mockResolvedValue({ data: { id: 'run-1', org_id: 'org-1' }, error: null }),
+      }),
+    };
+    requireUser.mockResolvedValue({
+      errorResponse: null,
+      user: { id: 'user-1' },
+      supabase: mockSupabase,
+    });
+    getVerifiedOrgMembership.mockResolvedValue({
+      membership_role: 'recruiter',
+      membership_status: 'active',
+    });
+
+    global.fetch.mockRejectedValue(new Error('Connection refused'));
+
+    const req = new Request('http://localhost:3000/api/employer/research-qa', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        hiring_run_id: 'run-1',
+        question: 'What is Readily Health?',
+      }),
+    });
+
+    const res = await POST(req);
+    expect(res.status).toBe(503);
+    const data = await res.json();
+    expect(data.code).toBe('SERVICE_UNAVAILABLE');
+  });
+});
