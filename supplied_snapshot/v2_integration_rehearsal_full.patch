+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { render, screen, fireEvent, waitFor } from '@testing-library/react';
+import ResearchQAPanel from '@/components/research/ResearchQAPanel';
+
+describe('ResearchQAPanel Component', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    global.fetch = vi.fn();
+  });
+
+  it('1. Renders panel, header, suggested queries, and mandatory disclaimer', () => {
+    render(<ResearchQAPanel hiringRunId="run-123" />);
+
+    expect(screen.getByTestId('research-qa-panel')).toBeInTheDocument();
+    expect(screen.getByText(/Public Research QA & Evidence Grounding/i)).toBeInTheDocument();
+    expect(screen.getByTestId('public-research-disclaimer')).toBeInTheDocument();
+    expect(screen.getByText(/PUBLIC RESEARCH \/ NOT EMPLOYER-APPROVED/i)).toBeInTheDocument();
+    expect(screen.getByTestId('research-qa-input')).toBeInTheDocument();
+    expect(screen.getByTestId('research-qa-submit-btn')).toBeInTheDocument();
+  });
+
+  it('2. Shows loading state when query is submitted', async () => {
+    // Hang fetch response to verify loading state
+    global.fetch.mockReturnValue(new Promise(() => {}));
+
+    render(<ResearchQAPanel hiringRunId="run-123" />);
+
+    const input = screen.getByTestId('research-qa-input');
+    fireEvent.change(input, { target: { value: 'What is Readily Health?' } });
+
+    const btn = screen.getByTestId('research-qa-submit-btn');
+    fireEvent.click(btn);
+
+    expect(screen.getByTestId('research-loading-state')).toBeInTheDocument();
+    expect(screen.getByText(/Retrieving source passages & verifying grounding/i)).toBeInTheDocument();
+  });
+
+  it('3. Renders grounded answer and expands citation when clicked', async () => {
+    global.fetch.mockResolvedValue({
+      ok: true,
+      status: 200,
+      json: async () => ({
+        answer: 'Readily Health provides AI-driven healthcare infrastructure.',
+        status: 'GROUNDED',
+        has_validation_errors: false,
+        latency_ms: 145,
+        citations: [
+          {
+            span_id: 'span_abc123',
+            quote: 'Readily Health provides AI-driven healthcare infrastructure.',
+            filename: '01_role_public_brief.md',
+            locator: 'TEXT_LINE:10-12',
+            source_url: 'https://readilyhealth.com/overview',
+          },
+        ],
+      }),
+    });
+
+    render(<ResearchQAPanel hiringRunId="run-123" />);
+
+    const input = screen.getByTestId('research-qa-input');
+    fireEvent.change(input, { target: { value: 'What is Readily Health?' } });
+    fireEvent.click(screen.getByTestId('research-qa-submit-btn'));
+
+    await waitFor(() => {
+      expect(screen.getByTestId('research-result-container')).toBeInTheDocument();
+    });
+
+    expect(screen.getByTestId('research-status-badge')).toHaveTextContent(/Grounded & Verified/i);
+    expect(screen.getByTestId('research-answer-text')).toHaveTextContent(/Readily Health provides AI-driven healthcare infrastructure/i);
+    expect(screen.getByTestId('citation-card-0')).toBeInTheDocument();
+
+    // Click to expand citation details
+    fireEvent.click(screen.getByText(/01_role_public_brief\.md/i));
+
+    expect(screen.getByText(/"Readily Health provides AI-driven healthcare infrastructure\."/i)).toBeInTheDocument();
+    expect(screen.getByText(/Span ID: span_abc123/i)).toBeInTheDocument();
+  });
+
+  it('4. Renders error message when service is unavailable (503)', async () => {
+    global.fetch.mockResolvedValue({
+      ok: false,
+      status: 503,
+      json: async () => ({ error: 'Engine service offline' }),
+    });
+
+    render(<ResearchQAPanel hiringRunId="run-123" />);
+
+    const input = screen.getByTestId('research-qa-input');
+    fireEvent.change(input, { target: { value: 'What is Readily Health?' } });
+    fireEvent.click(screen.getByTestId('research-qa-submit-btn'));
+
+    await waitFor(() => {
+      expect(screen.getByTestId('research-error-state')).toBeInTheDocument();
+    });
+
+    expect(screen.getByText(/Engine Service Unavailable/i)).toBeInTheDocument();
+  });
+});
diff --git a/apps/web/app/api/employer/research-qa/route.js b/apps/web/app/api/employer/research-qa/route.js
new file mode 100644
index 0000000..84741f9
--- /dev/null
+++ b/apps/web/app/api/employer/research-qa/route.js
@@ -0,0 +1,208 @@
+import { NextResponse } from 'next/server';
+import { requireUser, getVerifiedOrgMembership } from '@/lib/serverAuth';
+
+const ALLOWED_EMPLOYER_ROLES = ['owner', 'admin', 'recruiter', 'member'];
+
+export async function POST(request) {
+  // 1. Feature Flag Enforcement (Disabled by default)
+  const isFeatureEnabled =
+    process.env.NEXT_PUBLIC_ENABLE_RESEARCH_QA === 'true' ||
+    process.env.ENABLE_RESEARCH_QA === 'true';
+
+  if (!isFeatureEnabled) {
+    return NextResponse.json(
+      {
+        error: 'RESEARCH_QA_DISABLED',
+        message: 'The Research QA feature is disabled by organization policy.',
+        safe_next_action: 'Enable NEXT_PUBLIC_ENABLE_RESEARCH_QA to access public document QA.',
+      },
+      { status: 403 }
+    );
+  }
+
+  // 2. Authenticate User via Real Supabase Session
+  const authRes = await requireUser(request);
+  if (authRes.errorResponse) return authRes.errorResponse;
+  const { user, supabase } = authRes;
+
+  // 3. Parse and Validate Request Payload
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return NextResponse.json({ error: 'Invalid JSON payload' }, { status: 400 });
+  }
+
+  if (!body || typeof body !== 'object' || Array.isArray(body)) {
+    return NextResponse.json({ error: 'Request body must be a valid object' }, { status: 400 });
+  }
+
+  const { hiring_run_id, role_id, question, mode = 'retrieval_augmented' } = body;
+
+  if (!question || typeof question !== 'string' || !question.trim()) {
+    return NextResponse.json({ error: 'Question is required' }, { status: 400 });
+  }
+
+  const trimmedQuestion = question.trim();
+  if (trimmedQuestion.length > 1000) {
+    return NextResponse.json({ error: 'Question exceeds maximum length of 1,000 characters' }, { status: 400 });
+  }
+
+  // 4. Database-Backed Workspace Authorization (Never trust client-supplied workspace IDs)
+  let verifiedOrgId = null;
+
+  if (hiring_run_id) {
+    const { data: run, error: runErr } = await supabase
+      .from('hiring_runs')
+      .select('id, org_id')
+      .eq('id', hiring_run_id)
+      .single();
+
+    if (runErr || !run) {
+      return NextResponse.json(
+        { error: 'Hiring run not found or access denied', code: 'FORBIDDEN' },
+        { status: 404 }
+      );
+    }
+
+    const membership = await getVerifiedOrgMembership(supabase, user.id, run.org_id);
+    if (!membership || !ALLOWED_EMPLOYER_ROLES.includes(membership.membership_role)) {
+      return NextResponse.json(
+        { error: 'Forbidden: User does not belong to authorized organization', code: 'FORBIDDEN' },
+        { status: 403 }
+      );
+    }
+    verifiedOrgId = run.org_id;
+  } else {
+    const { data: memberships, error: memErr } = await supabase
+      .from('organization_memberships')
+      .select('organization_id, membership_role')
+      .eq('user_id', user.id)
+      .eq('membership_status', 'active')
+      .in('membership_role', ALLOWED_EMPLOYER_ROLES);
+
+    if (memErr || !memberships || memberships.length === 0) {
+      return NextResponse.json(
+        { error: 'Forbidden: No active organization membership found', code: 'FORBIDDEN' },
+        { status: 403 }
+      );
+    }
+    verifiedOrgId = memberships[0].organization_id;
+  }
+
+  // 5. Scoped Server-to-Server Call to Context Engine
+  const engineBaseUrl = process.env.WORKBYLINE_ENGINE_URL || 'http://127.0.0.1:8000';
+  const engineToken = process.env.WORKBYLINE_INTERNAL_SERVICE_KEY || 'scoped-internal-engine-key-v2';
+  const engineWorkspaceId = process.env.WORKBYLINE_RESEARCH_WORKSPACE_ID || 'ws_8b9eb121caea4a55';
+
+  const controller = new AbortController();
+  const timeoutId = setTimeout(() => controller.abort(), 15000);
+
+  try {
+    const engineRes = await fetch(
+      `${engineBaseUrl}/v1/workspaces/${engineWorkspaceId}/research-qa`,
+      {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+          'Authorization': `Bearer ${engineToken}`,
+        },
+        body: JSON.stringify({
+          question: trimmedQuestion,
+          mode: mode,
+          limit: 5,
+          role_id: role_id || null,
+        }),
+        signal: controller.signal,
+      }
+    );
+    clearTimeout(timeoutId);
+
+    if (engineRes.status === 401 || engineRes.status === 403) {
+      return NextResponse.json(
+        { error: 'Internal service authentication failure', code: 'ENGINE_AUTH_ERROR' },
+        { status: 502 }
+      );
+    }
+    if (engineRes.status === 404) {
+      return NextResponse.json(
+        { error: 'Research workspace not found in engine', code: 'WORKSPACE_NOT_FOUND' },
+        { status: 404 }
+      );
+    }
+
+    if (!engineRes.ok) {
+      const errData = await engineRes.json().catch(() => ({}));
+      const detailStr = String(errData.detail || '');
+
+      // Check if provider call was blocked due to missing/rotated key
+      if (detailStr.includes('GEMINI_API_KEY environment variable is not set')) {
+        if (process.env.MOCK_RESEARCH_QA_PROVIDER === 'true') {
+          return NextResponse.json({
+            answer:
+              '[MOCKED / DEV REHEARSAL] Readily Health provides AI-powered medical review infrastructure for health plans and provider networks, specifically automating prior authorization and clinical chart reviews.',
+            status: 'GROUNDED',
+            disclaimer:
+              'PUBLIC RESEARCH / NOT EMPLOYER-APPROVED. [MOCKED PROVIDER RESPONSE] Evaluated in offline dev rehearsal without live provider credentials.',
+            citations: [
+              {
+                span_id: 'span_21724ca5f4fd4688',
+                quote: 'Readily Health provides AI-powered medical review infrastructure',
+                filename: '02_product_public_context.md',
+                locator: 'TEXT_LINE:14-16',
+                source_url: 'https://readilyhealth.com/product',
+              },
+            ],
+            has_validation_errors: false,
+            latency_ms: 38,
+            execution_provenance: 'MOCKED_OFFLINE_REHEARSAL',
+          });
+        }
+
+        return NextResponse.json(
+          {
+            error: 'Provider credential unconfigured. Live Gemini generation is BLOCKED pending founder key rotation.',
+            code: 'BLOCKED_PENDING_KEY_ROTATION',
+            status: 'INSUFFICIENT_EVIDENCE',
+            disclaimer:
+              'PUBLIC RESEARCH / NOT EMPLOYER-APPROVED. Live provider calls are blocked pending rotation.',
+            citations: [],
+            execution_provenance: 'BLOCKED_PENDING_KEY_ROTATION',
+          },
+          { status: 503 }
+        );
+      }
+
+      return NextResponse.json(
+        { error: errData.detail || 'Context engine execution failed', code: 'ENGINE_ERROR' },
+        { status: engineRes.status }
+      );
+    }
+
+    const engineData = await engineRes.json();
+
+    // 6. Sanitize Response — Never expose internal tokens, credentials, or hidden model reasoning
+    return NextResponse.json({
+      answer: engineData.answer,
+      status: engineData.status,
+      disclaimer:
+        'PUBLIC RESEARCH / NOT EMPLOYER-APPROVED. This information is derived from indexed public web sources for recruiter context only. It does not establish candidate competence or modify hiring rubrics.',
+      citations: Array.isArray(engineData.citations) ? engineData.citations : [],
+      has_validation_errors: Boolean(engineData.has_validation_errors),
+      latency_ms: engineData.latency_ms || null,
+      execution_provenance: engineData.execution_provenance || 'LIVE_LOCAL_RETRIEVAL',
+    });
+  } catch (err) {
+    clearTimeout(timeoutId);
+    if (err.name === 'AbortError') {
+      return NextResponse.json(
+        { error: 'Research QA request timed out after 15 seconds', code: 'GATEWAY_TIMEOUT' },
+        { status: 504 }
+      );
+    }
+    return NextResponse.json(
+      { error: 'Context engine service temporarily unavailable', code: 'SERVICE_UNAVAILABLE' },
+      { status: 503 }
+    );
+  }
+}
