diff --git a/apps/web/components/research/ResearchQAPanel.jsx b/apps/web/components/research/ResearchQAPanel.jsx
new file mode 100644
index 0000000..3115d35
--- /dev/null
+++ b/apps/web/components/research/ResearchQAPanel.jsx
@@ -0,0 +1,409 @@
+"use client";
+
+import { useState } from "react";
+import {
+  Search,
+  Sparkles,
+  ShieldCheck,
+  AlertTriangle,
+  AlertCircle,
+  HelpCircle,
+  XCircle,
+  ExternalLink,
+  ChevronDown,
+  ChevronUp,
+  FileText,
+  Clock,
+  Lock,
+  Loader2,
+} from "lucide-react";
+
+const SUGGESTED_QUERIES = [
+  "What is Readily's core product and who does it serve?",
+  "What clinical compliance certifications are publicly claimed?",
+  "What funding amount did CHCF award and in what year?",
+  "Who is publicly identified as Readily's CISO?",
+  "Are customer documents used for model training?",
+];
+
+const STATUS_CONFIG = {
+  GROUNDED: {
+    label: "Grounded & Verified",
+    badgeClass: "bg-emerald-500/15 text-emerald-400 border-emerald-500/30",
+    icon: ShieldCheck,
+  },
+  AMBIGUOUS: {
+    label: "Ambiguous Evidence",
+    badgeClass: "bg-amber-500/15 text-amber-400 border-amber-500/30",
+    icon: AlertTriangle,
+  },
+  DISAGREEMENT: {
+    label: "Source Disagreement",
+    badgeClass: "bg-purple-500/15 text-purple-400 border-purple-500/30",
+    icon: AlertCircle,
+  },
+  INSUFFICIENT_EVIDENCE: {
+    label: "Insufficient Evidence (Abstained)",
+    badgeClass: "bg-zinc-500/15 text-zinc-300 border-zinc-500/30",
+    icon: HelpCircle,
+  },
+  UNVERIFIED_STATUS: {
+    label: "Unverified / Grounding Failed",
+    badgeClass: "bg-rose-500/15 text-rose-400 border-rose-500/30",
+    icon: XCircle,
+  },
+};
+
+export default function ResearchQAPanel({
+  hiringRunId = null,
+  roleId = null,
+  className = "",
+}) {
+  const [question, setQuestion] = useState("");
+  const [loading, setLoading] = useState(false);
+  const [result, setResult] = useState(null);
+  const [errorState, setErrorState] = useState(null);
+  const [expandedCitation, setExpandedCitation] = useState(null);
+
+  const handleSearch = async (queryText = question) => {
+    const q = queryText.trim();
+    if (!q) return;
+
+    setLoading(true);
+    setErrorState(null);
+    setResult(null);
+    setExpandedCitation(null);
+
+    try {
+      const res = await fetch("/api/employer/research-qa", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          hiring_run_id: hiringRunId,
+          role_id: roleId,
+          question: q,
+          mode: "retrieval_augmented",
+        }),
+      });
+
+      const data = await res.json();
+
+      if (!res.ok) {
+        if (res.status === 401) {
+          setErrorState({
+            type: "UNAUTHORIZED",
+            title: "Authentication Required",
+            message: "Your session has expired or is invalid. Please sign in.",
+          });
+        } else if (res.status === 403 && data.code === "RESEARCH_QA_DISABLED") {
+          setErrorState({
+            type: "DISABLED",
+            title: "Feature Disabled",
+            message: "Research QA is currently disabled by organization policy.",
+          });
+        } else if (res.status === 403 || res.status === 404) {
+          setErrorState({
+            type: "FORBIDDEN",
+            title: "Workspace Access Denied",
+            message: data.error || "You do not have authorization to query this workspace.",
+          });
+        } else if (res.status === 504) {
+          setErrorState({
+            type: "TIMEOUT",
+            title: "Gateway Timeout",
+            message: "The research query exceeded 15 seconds. Try asking a more specific question.",
+          });
+        } else if (res.status === 503) {
+          setErrorState({
+            type: "UNAVAILABLE",
+            title: "Engine Service Unavailable",
+            message: "The Context Engine service is temporarily offline or unreachable.",
+          });
+        } else {
+          setErrorState({
+            type: "ERROR",
+            title: "Query Execution Failed",
+            message: data.error || "An unexpected error occurred during execution.",
+          });
+        }
+        return;
+      }
+
+      setResult(data);
+    } catch (err) {
+      setErrorState({
+        type: "NETWORK_ERROR",
+        title: "Network Error",
+        message: err.message || "Failed to reach the research endpoint.",
+      });
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const statusInfo =
+    result && STATUS_CONFIG[result.status]
+      ? STATUS_CONFIG[result.status]
+      : STATUS_CONFIG.UNVERIFIED_STATUS;
+  const StatusIcon = statusInfo.icon;
+
+  return (
+    <div
+      role="region"
+      aria-label="Public Research Context Panel"
+      data-testid="research-qa-panel"
+      className={`rounded-2xl border border-white/[0.08] bg-[#111111] p-6 space-y-6 ${className}`}
+    >
+      {/* Header */}
+      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/[0.06] pb-4">
+        <div className="flex items-center gap-2.5">
+          <div className="h-8 w-8 rounded-lg bg-[#10D97A]/10 border border-[#10D97A]/20 flex items-center justify-center text-[#10D97A]">
+            <Sparkles className="h-4 w-4" />
+          </div>
+          <div>
+            <h3 className="text-sm font-semibold text-[#F2F2F2]">
+              Public Research QA & Evidence Grounding
+            </h3>
+            <p className="text-[11px] font-mono text-[#A3A3A3]">
+              Context Engine v0.4.0 • Readily Public Corpus
+            </p>
+          </div>
+        </div>
+
+        {/* Feature Isolation Notice Tag */}
+        <div className="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/[0.04] border border-white/[0.08] text-[10px] font-mono text-[#A3A3A3]">
+          <Lock className="h-3 w-3 text-amber-400" />
+          <span>Non-Scoring Auxiliary Context</span>
+        </div>
+      </div>
+
+      {/* Mandatory Public Data Disclaimer */}
+      <div
+        data-testid="public-research-disclaimer"
+        className="rounded-xl border border-amber-500/30 bg-amber-500/10 p-3.5 flex items-start gap-3 text-amber-200"
+      >
+        <AlertTriangle className="h-4 w-4 text-amber-400 shrink-0 mt-0.5" />
+        <div className="space-y-0.5">
+          <p className="text-[11px] font-mono uppercase tracking-wider font-semibold text-amber-300">
+            PUBLIC RESEARCH / NOT EMPLOYER-APPROVED
+          </p>
+          <p className="text-xs text-amber-200/90 leading-relaxed font-sans">
+            Research answers are retrieved strictly from indexed public web documents for recruiter background context. They do not automatically approve requirements, establish candidate competence, or alter hiring rubric evaluations.
+          </p>
+        </div>
+      </div>
+
+      {/* Search Input Box */}
+      <div className="space-y-3">
+        <form
+          onSubmit={(e) => {
+            e.preventDefault();
+            handleSearch();
+          }}
+          className="flex gap-2"
+        >
+          <div className="relative flex-1">
+            <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-[#A3A3A3]" />
+            <input
+              type="text"
+              data-testid="research-qa-input"
+              value={question}
+              onChange={(e) => setQuestion(e.target.value)}
+              placeholder="Ask a question about Readily's publicly documented business, clinical scope, or architecture..."
+              disabled={loading}
+              className="w-full pl-10 pr-4 py-2.5 rounded-xl border border-white/[0.1] bg-[#161616] text-xs text-[#F2F2F2] placeholder-[#666666] focus:outline-none focus:border-[#10D97A]/50 focus:ring-1 focus:ring-[#10D97A]/30 transition-all font-sans"
+            />
+          </div>
+          <button
+            type="submit"
+            data-testid="research-qa-submit-btn"
+            disabled={loading || !question.trim()}
+            className="px-5 py-2.5 rounded-xl border border-[#10D97A]/40 bg-[#10D97A] text-xs font-semibold text-[#0E0E0E] hover:bg-[#10D97A]/90 disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center gap-2 shrink-0"
+          >
+            {loading ? (
+              <>
+                <Loader2 className="h-3.5 w-3.5 animate-spin" />
+                <span>Verifying...</span>
+              </>
+            ) : (
+              <span>Ask Context</span>
+            )}
+          </button>
+        </form>
+
+        {/* Suggested Queries */}
+        <div className="flex items-center gap-1.5 flex-wrap">
+          <span className="text-[10px] font-mono text-[#A3A3A3] mr-1">Suggested:</span>
+          {SUGGESTED_QUERIES.map((sq, idx) => (
+            <button
+              key={idx}
+              type="button"
+              disabled={loading}
+              onClick={() => {
+                setQuestion(sq);
+                handleSearch(sq);
+              }}
+              className="text-[11px] px-2.5 py-1 rounded-lg bg-white/[0.04] border border-white/[0.08] text-[#A3A3A3] hover:text-[#F2F2F2] hover:bg-white/[0.08] transition-all text-left"
+            >
+              {sq}
+            </button>
+          ))}
+        </div>
+      </div>
+
+      {/* Progress / Loading State */}
+      {loading && (
+        <div
+          data-testid="research-loading-state"
+          className="rounded-xl border border-white/[0.08] bg-[#161616] p-6 text-center space-y-3"
+        >
+          <Loader2 className="h-6 w-6 text-[#10D97A] animate-spin mx-auto" />
+          <p className="text-xs text-[#F2F2F2] font-medium">
+            Retrieving source passages & verifying grounding...
+          </p>
+          <p className="text-[11px] font-mono text-[#A3A3A3]">
+            Executing BM25 lexical ranking and passage citation reconciliation
+          </p>
+        </div>
+      )}
+
+      {/* Error States */}
+      {errorState && (
+        <div
+          data-testid="research-error-state"
+          className="rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 space-y-1.5 text-rose-200"
+        >
+          <div className="flex items-center gap-2">
+            <XCircle className="h-4 w-4 text-rose-400 shrink-0" />
+            <h4 className="text-xs font-semibold text-rose-300">
+              {errorState.title}
+            </h4>
+          </div>
+          <p className="text-xs text-rose-200/80 pl-6 leading-relaxed">
+            {errorState.message}
+          </p>
+        </div>
+      )}
+
+      {/* Validated Result Display */}
+      {result && !loading && (
+        <div data-testid="research-result-container" className="space-y-4">
+          {/* Status Badge & Latency */}
+          <div className="flex items-center justify-between">
+            <div
+              data-testid="research-status-badge"
+              className={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium border ${statusInfo.badgeClass}`}
+            >
+              <StatusIcon className="h-3.5 w-3.5" />
+              <span>{statusInfo.label}</span>
+            </div>
+
+            {result.latency_ms && (
+              <span className="text-[10px] font-mono text-[#A3A3A3] flex items-center gap-1">
+                <Clock className="h-3 w-3" />
+                {result.latency_ms} ms
+              </span>
+            )}
+          </div>
+
+          {/* Validated Answer Box */}
+          <div
+            data-testid="research-answer-text"
+            className="rounded-xl border border-white/[0.08] bg-[#161616] p-4 text-xs text-[#F2F2F2] leading-relaxed whitespace-pre-wrap font-sans"
+          >
+            {result.answer || (
+              <span className="text-[#A3A3A3] italic">
+                No answer returned for this query.
+              </span>
+            )}
+          </div>
+
+          {/* Citations Section */}
+          {Array.isArray(result.citations) && result.citations.length > 0 ? (
+            <div className="space-y-2.5 pt-2">
+              <div className="flex items-center justify-between">
+                <h4 className="text-xs font-semibold text-[#F2F2F2] flex items-center gap-1.5">
+                  <FileText className="h-3.5 w-3.5 text-[#10D97A]" />
+                  <span>Verified Citations ({result.citations.length})</span>
+                </h4>
+                <span className="text-[10px] font-mono text-[#A3A3A3]">
+                  Exact quote substrings matched to disk sources
+                </span>
+              </div>
+
+              <div className="space-y-2">
+                {result.citations.map((cite, cIdx) => {
+                  const isExpanded = expandedCitation === cIdx;
+                  return (
+                    <div
+                      key={cIdx}
+                      data-testid={`citation-card-${cIdx}`}
+                      className="rounded-xl border border-white/[0.08] bg-[#161616] overflow-hidden transition-all"
+                    >
+                      <button
+                        type="button"
+                        onClick={() =>
+                          setExpandedCitation(isExpanded ? null : cIdx)
+                        }
+                        className="w-full p-3 flex items-center justify-between text-left hover:bg-white/[0.02] transition-colors"
+                      >
+                        <div className="flex items-center gap-2">
+                          <span className="px-1.5 py-0.5 rounded bg-white/[0.08] text-[10px] font-mono font-semibold text-[#10D97A]">
+                            [{cIdx + 1}]
+                          </span>
+                          <span className="text-xs font-medium text-[#F2F2F2]">
+                            {cite.filename || "Source Document"}
+                          </span>
+                          {cite.locator && (
+                            <span className="text-[10px] font-mono text-[#A3A3A3]">
+                              ({cite.locator})
+                            </span>
+                          )}
+                        </div>
+                        {isExpanded ? (
+                          <ChevronUp className="h-4 w-4 text-[#A3A3A3]" />
+                        ) : (
+                          <ChevronDown className="h-4 w-4 text-[#A3A3A3]" />
+                        )}
+                      </button>
+
+                      {isExpanded && (
+                        <div className="p-3 border-t border-white/[0.06] bg-[#0E0E0E] space-y-2 text-xs">
+                          {cite.quote && (
+                            <blockquote className="border-l-2 border-[#10D97A] pl-3 py-1 italic text-white/80 font-sans text-xs bg-white/[0.02]">
+                              "{cite.quote}"
+                            </blockquote>
+                          )}
+
+                          <div className="flex flex-wrap items-center justify-between gap-2 text-[10px] font-mono text-[#A3A3A3] pt-1">
+                            {cite.span_id && (
+                              <span>Span ID: {cite.span_id}</span>
+                            )}
+                            {cite.source_url && (
+                              <a
+                                href={cite.source_url}
+                                target="_blank"
+                                rel="noopener noreferrer"
+                                className="text-[#10D97A] hover:underline flex items-center gap-1"
+                              >
+                                View Source <ExternalLink className="h-2.5 w-2.5" />
+                              </a>
+                            )}
+                          </div>
+                        </div>
+                      )}
+                    </div>
+                  );
+                })}
+              </div>
+            </div>
+          ) : (
+            <div className="text-[11px] font-mono text-[#A3A3A3] italic py-2">
+              No citations attached to this response.
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
