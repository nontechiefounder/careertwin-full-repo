diff --git a/apps/web/__tests__/day4/EmployerDay4Assertions.test.js b/apps/web/__tests__/day4/EmployerDay4Assertions.test.js
new file mode 100644
index 0000000..507d82b
--- /dev/null
+++ b/apps/web/__tests__/day4/EmployerDay4Assertions.test.js
@@ -0,0 +1,248 @@
+const { test, expect } = require('playwright/test');
+const path = require('path');
+const dotenv = require('dotenv');
+
+dotenv.config({ path: path.join(process.cwd(), '.env.local') });
+
+// FAIL-CLOSED Credential Handling
+const pwd = process.env.CAREERTWIN_STAGING_TEST_PASSWORD;
+if (!pwd) {
+  throw new Error(
+    'FAIL-CLOSED: CAREERTWIN_STAGING_TEST_PASSWORD is required for authenticated Day 4 UAT.'
+  );
+}
+
+function required(value, label) {
+  if (value === undefined || value === null || value === '') {
+    throw new Error(`Required fixture field missing: ${label}`);
+  }
+  return value;
+}
+
+const BASE_URL = 'http://localhost:3000';
+const STAGING_OWNER_EMAIL = 'd2c.alpha.owner@example.com';
+const ALPHA_RUN_ID = '11111111-1111-4111-d2c1-111111111111';
+
+test.describe('Employer Day 4 UX-V2 Playwright Authenticated UAT Suite (UX-V2-D4)', () => {
+  test.beforeEach(async ({ page }) => {
+    await page.goto(`${BASE_URL}/auth`, { waitUntil: 'domcontentloaded' });
+    await page.fill('input[type="email"]', STAGING_OWNER_EMAIL);
+    await page.fill('input[type="password"]', pwd);
+    await page.click('button[type="submit"]');
+    await page.waitForFunction(() => window.location.pathname !== '/auth', { timeout: 15000 });
+  });
+
+  // ── Test A: Workspace loads without fabricated stats ──────────────────────
+  test('A — Workspace renders without hardcoded AVG TTH stat', async ({ page }) => {
+    await page.goto(`${BASE_URL}/employer`, { waitUntil: 'domcontentloaded' });
+    const bodyText = await page.textContent('body');
+    expect(bodyText).not.toContain('AVG TTH');
+    expect(bodyText).not.toContain('2.1d');
+  });
+
+  // ── Test B: Workspace does not show inaccurate tour copy ─────────────────
+  test('B — Workspace does not show inaccurate tour copy', async ({ page }) => {
+    await page.goto(`${BASE_URL}/employer`, { waitUntil: 'domcontentloaded' });
+    const bodyText = await page.textContent('body');
+    expect(bodyText).not.toContain('upload a JD');
+    expect(bodyText).not.toContain('Sync Your Stack');
+    expect(bodyText).not.toContain('Automate candidate delivery');
+    expect(bodyText).not.toContain('directly into Slack');
+  });
+
+  // ── Test C: Workspace stat cards contain EVALUATIONS ─────────────────────
+  test('C — Workspace shows EVALUATIONS stat card (not SCREENS DONE)', async ({ page }) => {
+    await page.goto(`${BASE_URL}/employer`, { waitUntil: 'domcontentloaded' });
+    const bodyText = await page.textContent('body');
+    expect(bodyText).toContain('EVALUATIONS');
+    expect(bodyText).not.toContain('SCREENS DONE');
+  });
+
+  // ── Test D: Workspace hiring run row shows proof-contract readiness chip ──
+  test('D — Hiring run row shows proof-status chip from live data', async ({ page }) => {
+    const analyticsRes = page.waitForResponse(
+      (r) => r.url().includes('/api/employer/analytics') && r.request().method() === 'GET'
+    );
+    await page.goto(`${BASE_URL}/employer`, { waitUntil: 'domcontentloaded' });
+    const analyticsResp = await analyticsRes;
+    expect(analyticsResp.status()).toBe(200);
+    const analyticsData = await analyticsResp.json();
+
+    const runs = analyticsData.runs || [];
+    if (runs.length > 0) {
+      const runId = runs[0].id;
+      await expect(page.getByTestId(`proof-status-${runId}`)).toBeVisible({ timeout: 10000 });
+      const chipText = await page.getByTestId(`proof-status-${runId}`).textContent();
+      expect(['Contract Ready', 'Incomplete'].some((v) => chipText.includes(v))).toBeTruthy();
+    }
+  });
+
+  // ── Test E: Workspace run row has Pipeline and Brief buttons with correct testids ──
+  test('E — Hiring run row has Pipeline and Brief nav buttons with testids', async ({ page }) => {
+    const runsRes = page.waitForResponse(
+      (r) => r.url().includes('/api/employer/analytics') && r.request().method() === 'GET'
+    );
+    await page.goto(`${BASE_URL}/employer`, { waitUntil: 'domcontentloaded' });
+    const runsResp = await runsRes;
+    const analyticsData = await runsResp.json();
+    const runs = analyticsData.runs || [];
+
+    if (runs.length > 0) {
+      const runId = runs[0].id;
+      await expect(page.getByTestId(`shortlist-btn-${runId}`)).toBeVisible({ timeout: 10000 });
+      await expect(page.getByTestId(`brief-btn-${runId}`)).toBeVisible({ timeout: 10000 });
+    }
+  });
+
+  // ── Test F: Brief page "View Candidate Pipeline" button is present ────────
+  test('F — Brief page shows "View Candidate Pipeline" (not "Start Sourcing Session")', async ({ page }) => {
+    await page.goto(`${BASE_URL}/employer/brief/${ALPHA_RUN_ID}`, { waitUntil: 'domcontentloaded' });
+    await page.waitForSelector('[data-testid="brief-page"]', { state: 'visible', timeout: 15000 });
+
+    const bodyText = await page.textContent('body');
+    // New label
+    expect(bodyText).toContain('View Candidate Pipeline');
+    // Old label must be gone
+    expect(bodyText).not.toContain('Start Sourcing Session');
+  });
+
+  // ── Test G: Brief page pipeline button navigates to shortlist ─────────────
+  test('G — Brief proceed-pipeline-btn navigates to /employer/shortlist/{id}', async ({ page }) => {
+    await page.goto(`${BASE_URL}/employer/brief/${ALPHA_RUN_ID}`, { waitUntil: 'domcontentloaded' });
+    await page.waitForSelector('[data-testid="brief-page"]', { state: 'visible', timeout: 15000 });
+
+    const proceedBtn = page.getByTestId('proceed-pipeline-btn');
+    await expect(proceedBtn).toBeVisible({ timeout: 10000 });
+    await proceedBtn.click();
+    await page.waitForURL(`**/employer/shortlist/${ALPHA_RUN_ID}`, { timeout: 10000 });
+    expect(page.url()).toContain(`/employer/shortlist/${ALPHA_RUN_ID}`);
+  });
+
+  // ── Test H: Brief page pipeline button does NOT POST sourcing-sessions ─────
+  test('H — Clicking pipeline button does not POST /sourcing-sessions', async ({ page }) => {
+    let sourcingPostCalled = false;
+    page.on('request', (req) => {
+      if (req.url().includes('/sourcing-sessions') && req.method() === 'POST') {
+        sourcingPostCalled = true;
+      }
+    });
+
+    await page.goto(`${BASE_URL}/employer/brief/${ALPHA_RUN_ID}`, { waitUntil: 'domcontentloaded' });
+    await page.waitForSelector('[data-testid="brief-page"]', { state: 'visible', timeout: 15000 });
+
+    const proceedBtn = page.getByTestId('proceed-pipeline-btn');
+    await expect(proceedBtn).toBeVisible({ timeout: 10000 });
+    await proceedBtn.click();
+    await page.waitForURL(`**/employer/shortlist/${ALPHA_RUN_ID}`, { timeout: 10000 });
+
+    expect(sourcingPostCalled).toBe(false);
+  });
+
+  // ── Test I: Shortlist page (zero cohort) shows handoff guidance panel ─────
+  test('I — Shortlist zero-cohort state shows handoff guidance panel', async ({ page }) => {
+    await page.goto(`${BASE_URL}/employer/shortlist/${ALPHA_RUN_ID}`, { waitUntil: 'domcontentloaded' });
+    await page.waitForSelector('main', { state: 'visible', timeout: 15000 });
+
+    // Either we have candidates (shortlist) or zero state with handoff
+    const hasHandoffPanel = await page.locator('[data-testid="handoff-guidance-panel"]').count();
+    const hasCandidates = await page.locator('[data-testid^="candidate-card-"]').count();
+
+    // If no candidates evaluated, handoff guidance must be present
+    if (hasCandidates === 0) {
+      expect(hasHandoffPanel).toBeGreaterThan(0);
+    }
+    // (If candidates exist, shortlist renders normally — test still passes)
+  });
+
+  // ── Test J: Handoff panel does not contain hardcoded contact info ─────────
+  test('J — Handoff guidance panel does not expose internal contact details', async ({ page }) => {
+    await page.goto(`${BASE_URL}/employer/shortlist/${ALPHA_RUN_ID}`, { waitUntil: 'domcontentloaded' });
+    await page.waitForSelector('main', { state: 'visible', timeout: 15000 });
+
+    const hasHandoffPanel = await page.locator('[data-testid="handoff-guidance-panel"]').count();
+    if (hasHandoffPanel > 0) {
+      const panelText = await page.getByTestId('handoff-guidance-panel').textContent();
+      // Must not contain email addresses or phone numbers
+      expect(panelText).not.toMatch(/@[A-Za-z0-9._%+-]+\.[A-Za-z]{2,}/);
+      expect(panelText).not.toMatch(/\+?[0-9]{10,}/);
+    }
+  });
+
+  // ── Test K: Shortlist API returns 200 with org-scoped data ────────────────
+  test('K — GET /api/employer/shortlist/{id} returns 200 with org-scoped candidates', async ({ page }) => {
+    const shortlistRes = page.waitForResponse(
+      (r) =>
+        r.url().includes(`/api/employer/shortlist/${ALPHA_RUN_ID}`) &&
+        r.request().method() === 'GET'
+    );
+    await page.goto(`${BASE_URL}/employer/shortlist/${ALPHA_RUN_ID}`, { waitUntil: 'domcontentloaded' });
+    const resp = await shortlistRes;
+    expect(resp.status()).toBe(200);
+    const data = await resp.json();
+    expect(data).toHaveProperty('candidates');
+    expect(data).toHaveProperty('run');
+  });
+
+  // ── Test L: Proof contract breadcrumb readiness badge on brief page ────────
+  test('L — Brief page contract-readiness-badge is present with PROOF CONTRACT COMPLETE or SOURCING BLOCKED', async ({ page }) => {
+    await page.goto(`${BASE_URL}/employer/brief/${ALPHA_RUN_ID}`, { waitUntil: 'domcontentloaded' });
+    await page.waitForSelector('[data-testid="contract-readiness-badge"]', {
+      state: 'visible',
+      timeout: 15000,
+    });
+    const badgeText = await page.getByTestId('contract-readiness-badge').textContent();
+    expect(['PROOF CONTRACT COMPLETE', 'SOURCING BLOCKED'].some((v) => badgeText.includes(v))).toBeTruthy();
+  });
+
+  // ── Test M: Intake page does not show upload-to-server control ────────────
+  test('M — Intake form does not offer server-upload control for candidate documents', async ({ page }) => {
+    await page.goto(`${BASE_URL}/employer/intake`, { waitUntil: 'domcontentloaded' });
+    await page.waitForSelector('[data-testid="intake-page"]', { state: 'visible', timeout: 15000 });
+
+    // The dropzone must show the handoff notice text
+    const handoffNotice = page.getByTestId('intake-handoff-notice');
+    await expect(handoffNotice).toBeVisible({ timeout: 5000 });
+
+    // There must be no XHR/fetch button that triggers server-side file upload
+    const bodyText = await page.textContent('body');
+    expect(bodyText).not.toContain('Upload to server');
+    expect(bodyText).not.toContain('Submit documents');
+  });
+
+  // ── Test N: Workspace does not fabricate org membership context ──────────
+  test('N — Employer workspace page loads with real org-scoped hiring runs only', async ({ page }) => {
+    const hiringRunsRes = page.waitForResponse(
+      (r) => r.url().includes('/api/employer/hiring-runs') && r.request().method() === 'GET'
+    );
+    await page.goto(`${BASE_URL}/employer`, { waitUntil: 'domcontentloaded' });
+    const resp = await hiringRunsRes;
+    expect(resp.status()).toBe(200);
+    const data = await resp.json();
+    // Must be an array (not a mock object)
+    expect(Array.isArray(data)).toBe(true);
+  });
+
+  // ── Test O: Brief page incomplete contract blocks pipeline button ─────────
+  test('O — Incomplete proof contract shows "Complete Role Intake" blocker instead of pipeline button', async ({ page }) => {
+    // We assert the conditional rendering: if contract is blocked, there is NO proceed-pipeline-btn
+    // and there IS a complete-intake-btn. We test the alpha fixture which may be complete,
+    // so we assert the correct button for whichever state the fixture is in.
+    await page.goto(`${BASE_URL}/employer/brief/${ALPHA_RUN_ID}`, { waitUntil: 'domcontentloaded' });
+    await page.waitForSelector('[data-testid="brief-page"]', { state: 'visible', timeout: 15000 });
+
+    const badgeText = await page.getByTestId('contract-readiness-badge').textContent();
+    const isComplete = badgeText.includes('PROOF CONTRACT COMPLETE');
+
+    if (isComplete) {
+      // Pipeline button must be present
+      await expect(page.getByTestId('proceed-pipeline-btn')).toBeVisible({ timeout: 8000 });
+      // Intake blocker must not be present
+      expect(await page.getByTestId('complete-intake-btn').count()).toBe(0);
+    } else {
+      // Intake blocker must be present
+      await expect(page.getByTestId('complete-intake-btn')).toBeVisible({ timeout: 8000 });
+      // Pipeline button must not be present
+      expect(await page.getByTestId('proceed-pipeline-btn').count()).toBe(0);
+    }
+  });
+});
diff --git a/apps/web/__tests__/day4/ProofContractReadiness.test.js b/apps/web/__tests__/day4/ProofContractReadiness.test.js
new file mode 100644
index 0000000..388cc15
--- /dev/null
+++ b/apps/web/__tests__/day4/ProofContractReadiness.test.js
@@ -0,0 +1,100 @@
+import { describe, it, expect } from 'vitest';
+import { evaluateProofContractReadiness } from '@/lib/proofContractReadiness';
+
+describe('evaluateProofContractReadiness — shared utility (UX-V2-D4)', () => {
+  // 1. Complete contract
+  it('1. isComplete=true when title, job_description, and must_haves are all present', () => {
+    const result = evaluateProofContractReadiness({
+      role_title: 'Backend Engineer',
+      job_description: 'Build APIs at scale with Python and FastAPI.',
+      must_haves: ['Python 3.10+', 'FastAPI'],
+    });
+    expect(result.isComplete).toBe(true);
+    expect(result.missingFields).toHaveLength(0);
+  });
+
+  // 2. Missing title
+  it('2. isComplete=false and missingFields contains role_title when title is missing', () => {
+    const result = evaluateProofContractReadiness({
+      role_title: '',
+      job_description: 'Build APIs at scale with Python and FastAPI.',
+      must_haves: ['Python 3.10+'],
+    });
+    expect(result.isComplete).toBe(false);
+    expect(result.missingFields).toContain('role_title');
+  });
+
+  // 3. Missing job description
+  it('3. isComplete=false when job_description is missing and no role_summary', () => {
+    const result = evaluateProofContractReadiness({
+      role_title: 'Backend Engineer',
+      job_description: '',
+      must_haves: ['Python 3.10+'],
+    });
+    expect(result.isComplete).toBe(false);
+    expect(result.missingFields).toContain('job_description');
+  });
+
+  // 4. Short description rejected
+  it('4. isComplete=false when job_description is shorter than 10 chars', () => {
+    const result = evaluateProofContractReadiness({
+      role_title: 'Backend Engineer',
+      job_description: 'Short',
+      must_haves: ['Python'],
+    });
+    expect(result.isComplete).toBe(false);
+  });
+
+  // 5. role_summary accepted as alternative
+  it('5. isComplete=true when role_summary >= 10 chars and must_haves provided', () => {
+    const result = evaluateProofContractReadiness({
+      role_title: 'Data Engineer',
+      role_summary: 'Build pipelines for internal analytics.',
+      must_haves: ['dbt', 'Postgres'],
+    });
+    expect(result.isComplete).toBe(true);
+  });
+
+  // 6. Empty must_haves array
+  it('6. isComplete=false when must_haves is an empty array', () => {
+    const result = evaluateProofContractReadiness({
+      role_title: 'Backend Engineer',
+      job_description: 'Build APIs at scale with Python and FastAPI.',
+      must_haves: [],
+    });
+    expect(result.isComplete).toBe(false);
+    expect(result.missingFields).toContain('must_haves');
+  });
+
+  // 7. explicit_requirements as alternative to must_haves
+  it('7. isComplete=true when explicit_requirements is provided instead of must_haves', () => {
+    const result = evaluateProofContractReadiness({
+      role_title: 'Backend Engineer',
+      job_description: 'Build APIs at scale with Python and FastAPI.',
+      explicit_requirements: ['5+ years Python'],
+    });
+    expect(result.isComplete).toBe(true);
+  });
+
+  // 8. Null runData does not throw
+  it('8. returns isComplete=false for null input without throwing', () => {
+    const result = evaluateProofContractReadiness(null);
+    expect(result.isComplete).toBe(false);
+    expect(result.missingFields).toHaveLength(3);
+  });
+
+  // 9. Undefined runData does not throw
+  it('9. returns isComplete=false for undefined input without throwing', () => {
+    const result = evaluateProofContractReadiness(undefined);
+    expect(result.isComplete).toBe(false);
+  });
+
+  // 10. All three fields missing lists all three in missingFields
+  it('10. all three missing fields listed when runData is empty object', () => {
+    const result = evaluateProofContractReadiness({});
+    expect(result.isComplete).toBe(false);
+    expect(result.missingFields).toContain('role_title');
+    expect(result.missingFields).toContain('job_description');
+    expect(result.missingFields).toContain('must_haves');
+  });
+});
diff --git a/apps/web/__tests__/security/SourcingSessionSecurity.test.js b/apps/web/__tests__/security/SourcingSessionSecurity.test.js
new file mode 100644
index 0000000..6ebb1b3
--- /dev/null
+++ b/apps/web/__tests__/security/SourcingSessionSecurity.test.js
@@ -0,0 +1,303 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+
+vi.mock('@/lib/serverAuth', () => ({
+  requireUser: vi.fn(),
+  getVerifiedOrgMembership: vi.fn(),
+}));
+
+import { POST } from '@/app/api/employer/sourcing-sessions/route';
+import { requireUser, getVerifiedOrgMembership } from '@/lib/serverAuth';
+
+const VALID_RUN_ID = 'aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa';
+const ORG_ID = 'bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbbb';
+
+describe('Sourcing Session Route Security — UX-V2-D4 (10 cases)', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  // ── 1. 401 unauthenticated ────────────────────────────────────────────────
+  it('1. returns 401 for unauthenticated POST', async () => {
+    requireUser.mockResolvedValueOnce({
+      errorResponse: new Response(JSON.stringify({ error: 'Unauthorized' }), { status: 401 }),
+      user: null,
+      supabase: null,
+    });
+    const req = new Request('http://localhost/api/employer/sourcing-sessions', {
+      method: 'POST',
+      body: JSON.stringify({ hiring_run_id: VALID_RUN_ID }),
+    });
+    const res = await POST(req);
+    expect(res.status).toBe(401);
+  });
+
+  // ── 2. 400 invalid JSON ───────────────────────────────────────────────────
+  it('2. returns 400 for invalid JSON body', async () => {
+    requireUser.mockResolvedValueOnce({
+      errorResponse: null,
+      user: { id: 'u1' },
+      supabase: {},
+    });
+    const req = new Request('http://localhost/api/employer/sourcing-sessions', {
+      method: 'POST',
+      body: 'not-json',
+    });
+    const res = await POST(req);
+    expect(res.status).toBe(400);
+    const data = await res.json();
+    expect(data.error).toBe('Invalid JSON payload');
+  });
+
+  // ── 3. 400 missing hiring_run_id ──────────────────────────────────────────
+  it('3. returns 400 when hiring_run_id is missing', async () => {
+    requireUser.mockResolvedValueOnce({
+      errorResponse: null,
+      user: { id: 'u1' },
+      supabase: {},
+    });
+    const req = new Request('http://localhost/api/employer/sourcing-sessions', {
+      method: 'POST',
+      body: JSON.stringify({}),
+    });
+    const res = await POST(req);
+    expect(res.status).toBe(400);
+    const data = await res.json();
+    expect(data.error).toContain('hiring_run_id');
+  });
+
+  // ── 4. 400 non-UUID hiring_run_id ─────────────────────────────────────────
+  it('4. returns 400 for non-UUID hiring_run_id', async () => {
+    requireUser.mockResolvedValueOnce({
+      errorResponse: null,
+      user: { id: 'u1' },
+      supabase: {},
+    });
+    const req = new Request('http://localhost/api/employer/sourcing-sessions', {
+      method: 'POST',
+      body: JSON.stringify({ hiring_run_id: 'not-a-uuid' }),
+    });
+    const res = await POST(req);
+    expect(res.status).toBe(400);
+  });
+
+  // ── 5. 404 unknown hiring_run_id ──────────────────────────────────────────
+  it('5. returns 404 when hiring run does not exist', async () => {
+    const mockSupabase = {
+      from: vi.fn().mockReturnValue({
+        select: vi.fn().mockReturnValue({
+          eq: vi.fn().mockReturnValue({
+            single: vi.fn().mockResolvedValue({ data: null, error: { message: 'Not found' } }),
+          }),
+        }),
+      }),
+    };
+    requireUser.mockResolvedValueOnce({
+      errorResponse: null,
+      user: { id: 'u1' },
+      supabase: mockSupabase,
+    });
+    const req = new Request('http://localhost/api/employer/sourcing-sessions', {
+      method: 'POST',
+      body: JSON.stringify({ hiring_run_id: 'cccccccc-cccc-4ccc-cccc-cccccccccccc' }),
+    });
+    const res = await POST(req);
+    expect(res.status).toBe(404);
+    const data = await res.json();
+    expect(data.error).toBe('Hiring run not found');
+  });
+
+  // ── 6. 403 no org membership ──────────────────────────────────────────────
+  it('6. returns 403 when user has no org membership', async () => {
+    const mockSupabase = {
+      from: vi.fn().mockReturnValue({
+        select: vi.fn().mockReturnValue({
+          eq: vi.fn().mockReturnValue({
+            single: vi.fn().mockResolvedValue({ data: { id: VALID_RUN_ID, org_id: ORG_ID, status: 'active' }, error: null }),
+          }),
+        }),
+      }),
+    };
+    requireUser.mockResolvedValueOnce({
+      errorResponse: null,
+      user: { id: 'u1' },
+      supabase: mockSupabase,
+    });
+    getVerifiedOrgMembership.mockResolvedValueOnce(null);
+
+    const req = new Request('http://localhost/api/employer/sourcing-sessions', {
+      method: 'POST',
+      body: JSON.stringify({ hiring_run_id: VALID_RUN_ID }),
+    });
+    const res = await POST(req);
+    expect(res.status).toBe(403);
+    const data = await res.json();
+    expect(data.error).toBe('Forbidden');
+  });
+
+  // ── 7. 403 auditor role forbidden ─────────────────────────────────────────
+  it('7. returns 403 for auditor-role membership (cannot create sessions)', async () => {
+    const mockSupabase = {
+      from: vi.fn().mockReturnValue({
+        select: vi.fn().mockReturnValue({
+          eq: vi.fn().mockReturnValue({
+            single: vi.fn().mockResolvedValue({ data: { id: VALID_RUN_ID, org_id: ORG_ID, status: 'active' }, error: null }),
+          }),
+        }),
+      }),
+    };
+    requireUser.mockResolvedValueOnce({
+      errorResponse: null,
+      user: { id: 'u1' },
+      supabase: mockSupabase,
+    });
+    getVerifiedOrgMembership.mockResolvedValueOnce({ membership_role: 'auditor' });
+
+    const req = new Request('http://localhost/api/employer/sourcing-sessions', {
+      method: 'POST',
+      body: JSON.stringify({ hiring_run_id: VALID_RUN_ID }),
+    });
+    const res = await POST(req);
+    expect(res.status).toBe(403);
+  });
+
+  // ── 8. 200 success path — no agent triggered ──────────────────────────────
+  it('8. creates session with status pending_handoff (no external agent triggered)', async () => {
+    const insertedSession = {
+      id: 'dddddddd-dddd-4ddd-dddd-dddddddddddd',
+      employer_id: 'u1',
