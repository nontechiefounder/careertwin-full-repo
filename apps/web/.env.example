# ==============================================================================
# workBYLiNE Web Application Environment Template
# ==============================================================================
# IMPORTANT: Variable names only with BLANK values (or safety defaults).
# NEVER place secret keys, passwords, or live customer tokens in this file.

# Supabase Authentication & Database Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Staging Environment Verification Configuration
CAREERTWIN_STAGING_SUPABASE_URL=
CAREERTWIN_STAGING_PUBLISHABLE_KEY=
CAREERTWIN_STAGING_TEST_PASSWORD=

# Safety Enforcement: External Email Suppression
# Must be set to 'true' in all non-production and staging verification environments
CAREERTWIN_DRY_RUN_EMAIL=true

# Application URL & Port Configuration
PORT=3000
NEXT_PUBLIC_URL=http://localhost:3000

# Model Provider Integration Gateway (External calls gated; leave blank unless explicitly authorized)
# Employer document chat: explicit opt-in; keep false for offline runs.
WORKBYLINE_GENERATION_GATE=false
GEMINI_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Provider selection: preference ordering by default ('groq' | 'gemini' | 'claude' | 'openai')
WORKBYLINE_AI_PROVIDER=
# Set to 'true' to strictly restrict generation to WORKBYLINE_AI_PROVIDER with zero fallback
WORKBYLINE_AI_STRICT_PROVIDER=false

# Sourcing & ATS External Integrations (Fail closed when absent; never enable synthetic_sandbox in production)
CRUSTDATA_API_KEY=
CRUSTDATA_AUTH_TOKEN=
DATAVERTEX_API_KEY=
DATAVERTEX_MAX_CREDITS=2
CORESIGNAL_API_KEY=
ASHBY_API_KEY=

# Context Engine Integration (Research QA Proxy)
# Feature flag: set to 'true' to enable the /api/employer/research-qa route
NEXT_PUBLIC_ENABLE_RESEARCH_QA=false
ENABLE_RESEARCH_QA=false
# Base URL where the Context Engine FastAPI service is running
WORKBYLINE_ENGINE_URL=http://127.0.0.1:8000
# Scoped internal service token for server-to-server authentication
WORKBYLINE_INTERNAL_SERVICE_KEY=
# Workspace ID containing indexed public research documents
WORKBYLINE_RESEARCH_WORKSPACE_ID=
# Set to 'true' to return mocked responses when provider keys are missing
MOCK_RESEARCH_QA_PROVIDER=false

# Context Evidence Service Configuration
WORKBYLINE_CONTEXT_SERVICE_URL=http://127.0.0.1:8011
WORKBYLINE_CONTEXT_DELEGATION_SECRET=
WORKBYLINE_ENGINE_MAPPINGS=

# External Email & OAuth Gateway (Strictly suppressed when CAREERTWIN_DRY_RUN_EMAIL=true)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SYSTEM_EMAIL_HOST=
SYSTEM_EMAIL_PORT=
SYSTEM_EMAIL_USER=
SYSTEM_EMAIL_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_OAUTH_STATE_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Database & JWT Secrets (Server-only; never expose in browser bundles)
SUPABASE_JWT_SECRET=
DISPOSABLE_DATABASE_URL=
DISPOSABLE_DB_CONTAINER=
