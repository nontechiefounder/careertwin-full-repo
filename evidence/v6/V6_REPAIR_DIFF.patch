+import { NextResponse } from 'next/server';
+import { createSupabaseServerClient } from '@/lib/supabaseServer';
+import { deliverVerificationEmail } from '@/lib/verificationEmail';
+
+const RESEND_COOLDOWN_MS = 60_000;
+const recentResendByEmail = new Map();
+
+export function __resetResendCooldownForTests() {
+  recentResendByEmail.clear();
+}
+
+export async function POST(request) {
+  try {
+    const body = await request.json();
+    const email = typeof body?.email === 'string' ? body.email.trim().toLowerCase() : '';
+
+    if (!email || !email.includes('@')) {
+      return NextResponse.json({ error: 'Valid email is required' }, { status: 400 });
+    }
+
+    const now = Date.now();
+    const lastAttempt = recentResendByEmail.get(email);
+    if (lastAttempt && now - lastAttempt < RESEND_COOLDOWN_MS) {
+      return NextResponse.json(
+        {
+          error: 'RATE_LIMITED',
+          retry_after_seconds: Math.ceil((RESEND_COOLDOWN_MS - (now - lastAttempt)) / 1000),
+          message: 'Please wait before requesting another verification email.',
+        },
+        { status: 429 }
+      );
+    }
+
+    const supabase = await createSupabaseServerClient(null, true);
+
+    // Prevent blindly recreating accounts; verify existing unconfirmed user when listUsers is available
+    if (typeof supabase.auth?.admin?.listUsers === 'function') {
+      const { data: listData, error: listErr } = await supabase.auth.admin.listUsers({ perPage: 1000 });
+      if (listErr) {
+        return NextResponse.json({ error: 'Verification lookup unavailable' }, { status: 503 });
+      }
+      const existing = (listData?.users || []).find(
+        (u) => typeof u?.email === 'string' && u.email.toLowerCase() === email
+      );
+      if (!existing || existing.email_confirmed_at) {
+        return NextResponse.json({
+          delivery_status: 'ignored_or_already_verified',
+          email_sent: false,
+          message: 'If an unverified account exists for this email, a verification email will be sent.',
+        });
+      }
+    }
+
+    recentResendByEmail.set(email, now);
+    const delivery = await deliverVerificationEmail({ supabase, email, isResend: true });
+
+    return NextResponse.json(
+      {
+        delivery_status: delivery.delivery_status,
+        email_sent: delivery.email_sent,
+        retry_supported: delivery.retry_supported,
+        message: delivery.message,
+        ...(delivery.error ? { error: delivery.error } : {}),
+      },
+      { status: delivery.status }
+    );
+  } catch (error) {
+    console.error('[API Resend Verification] Unexpected error:', error?.message || error);
+    return NextResponse.json({ error: 'Internal server error' }, { status: 500 });
+  }
+}
