+    else:
+        require_membership(db, workspace_id, principal_id)
+
+    if payload.role_id:
+        role = db.get(Role, payload.role_id)
+        if not role or role.workspace_id != workspace_id:
+            raise HTTPException(status_code=404, detail="role not found in workspace")
+    try:
