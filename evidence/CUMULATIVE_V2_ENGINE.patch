+  },
+  {
+    q: "How long does evaluation take?",
+    a: "Candidate evaluation processes applicant portfolios with deterministic provenance citations, delivering 2–5 reviewed candidate packets with human review controls."
+  },
+  {
+    q: "Is my data secure?",
+    a: "All data is encrypted in transit and at rest. We only store information you explicitly provide, never scrape third-party platforms without permissioned APIs."
+  }
+];
+
+function FAQItem({ q, a }) {
+  const [open, setOpen] = useState(false);
