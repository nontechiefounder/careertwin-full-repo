+    source_id: str
+    filename: str
+    text: str
+    score: float
+    source_url: str | None
+    status: str = "PUBLIC_RESEARCH / NOT_EMPLOYER_APPROVED"
+    employer_approval: str = "NOT_OBTAINED"
+
