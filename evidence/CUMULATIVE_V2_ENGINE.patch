--- /dev/null
+++ b/supplied_snapshot/source/apps/web/app/api/employer/context-sources/route.js
@@ -0,0 +1,94 @@
+import { NextResponse } from 'next/server';
+import { requireUser, getVerifiedOrgMembership } from '@/lib/serverAuth';
+
+const ALLOWED_EMPLOYER_ROLES = ['owner', 'admin', 'recruiter', 'member'];
+
+export async function GET(request) {
+  const authRes = await requireUser(request);
+  if (authRes.errorResponse) return authRes.errorResponse;
+  const { user, supabase } = authRes;
+
+  const { searchParams } = new URL(request.url);
+  const orgId = searchParams.get('org_id');
+  const hiringRunId = searchParams.get('hiring_run_id');
+
+  let targetOrgId = orgId;
+  if (!targetOrgId && hiringRunId) {
+    const { data: run } = await supabase
+      .from('hiring_runs')
+      .select('org_id')
+      .eq('id', hiringRunId.trim())
+      .single();
+    if (run) targetOrgId = run.org_id;
+  }
+
+  if (!targetOrgId) {
+    const { data: memberships } = await supabase
+      .from('organization_memberships')
+      .select('org_id')
+      .eq('user_id', user.id);
+    if (!memberships || memberships.length === 0) {
+      return NextResponse.json({ error: 'No organization membership found' }, { status: 403 });
+    }
+    targetOrgId = memberships[0].org_id;
+  }
+
+  const membership = await getVerifiedOrgMembership(supabase, user.id, targetOrgId);
+  if (!membership || !ALLOWED_EMPLOYER_ROLES.includes(membership.membership_role)) {
+    return NextResponse.json({ error: 'Forbidden' }, { status: 403 });
+  }
+
+  // Fetch sources with their versions
+  const { data: sources, error } = await supabase
+    .from('context_source_objects')
+    .select(`
+      id,
+      org_id,
+      workspace_id,
+      source_uri,
+      source_kind,
+      confidentiality,
+      created_at,
+      context_source_versions (
+        id,
+        version_number,
+        original_file_sha256,
+        original_mime_type,
+        byte_size,
+        status,
+        effective_time,
+        ingested_at
+      )
+    `)
+    .eq('org_id', targetOrgId)
+    .order('created_at', { ascending: false });
+
+  if (error) {
+    return NextResponse.json({ error: error.message }, { status: 500 });
+  }
+
+  // Format response with active version and version count
+  const formattedSources = (sources || []).map((s) => {
+    const versions = (s.context_source_versions || []).sort(
+      (a, b) => b.version_number - a.version_number
+    );
+    const activeVersion = versions.find((v) => v.status === 'completed' || v.status === 'partial') || versions[0] || null;
+
+    return {
+      id: s.id,
+      source_uri: s.source_uri,
+      source_kind: s.source_kind,
+      confidentiality: s.confidentiality,
+      created_at: s.created_at,
+      version_count: versions.length,
+      active_version: activeVersion,
+      versions,
+    };
+  });
+
+  return NextResponse.json({
+    ok: true,
+    sources: formattedSources,
+    total_count: formattedSources.length,
+  });
+}
diff --git a/supplied_snapshot/source/apps/web/app/api/employer/context-sources/upload/route.js b/supplied_snapshot/source/apps/web/app/api/employer/context-sources/upload/route.js
new file mode 100644
index 0000000..148d207
--- /dev/null
+++ b/supplied_snapshot/source/apps/web/app/api/employer/context-sources/upload/route.js
@@ -0,0 +1,246 @@
+import { NextResponse } from 'next/server';
+import crypto from 'crypto';
+import { requireUser, getVerifiedOrgMembership } from '@/lib/serverAuth';
+import { processOutboxEvent, extractEvidenceSpans } from '@/lib/contextEvidenceWorker';
+
+const ALLOWED_EMPLOYER_ROLES = ['owner', 'admin', 'recruiter', 'member'];
+const ALLOWED_SOURCE_KINDS = ['RESUME', 'JOB_DESCRIPTION', 'COMPANY_RESEARCH', 'INTERVIEW_NOTES', 'PORTFOLIO'];
+
+export async function POST(request) {
+  // 1. Authenticate employer
+  const authRes = await requireUser(request);
+  if (authRes.errorResponse) return authRes.errorResponse;
+  const { user, supabase } = authRes;
+
+  // 2. Parse request payload (supports JSON or multipart)
+  let body;
+  try {
+    const contentType = request.headers.get('content-type') || '';
+    if (contentType.includes('application/json')) {
+      body = await request.json();
+    } else {
+      const formData = await request.formData();
+      body = {
+        org_id: formData.get('org_id'),
+        hiring_run_id: formData.get('hiring_run_id'),
+        source_uri: formData.get('source_uri') || formData.get('filename'),
+        source_kind: formData.get('source_kind') || 'RESUME',
+        content: formData.get('content'),
+        effective_time: formData.get('effective_time'),
+      };
+    }
+  } catch {
+    return NextResponse.json({ error: 'Failed to parse request payload', code: 'INVALID_PAYLOAD' }, { status: 400 });
+  }
+
+  const {
+    org_id,
+    hiring_run_id,
+    source_uri,
+    source_kind = 'RESUME',
+    content,
+    effective_time = null,
+  } = body || {};
+
+  if (!source_uri || typeof source_uri !== 'string' || !source_uri.trim()) {
+    return NextResponse.json({ error: 'source_uri or filename is required', code: 'MISSING_SOURCE_URI' }, { status: 400 });
+  }
+
+  if (!ALLOWED_SOURCE_KINDS.includes(source_kind)) {
+    return NextResponse.json(
+      { error: `Invalid source_kind '${source_kind}'. Allowed: ${ALLOWED_SOURCE_KINDS.join(', ')}`, code: 'INVALID_SOURCE_KIND' },
+      { status: 400 }
+    );
+  }
+
+  // 3. Resolve Organization and verify membership
+  let targetOrgId = org_id;
+  if (!targetOrgId && hiring_run_id) {
+    const { data: run } = await supabase
+      .from('hiring_runs')
+      .select('org_id')
+      .eq('id', hiring_run_id.trim())
+      .single();
+    if (run) targetOrgId = run.org_id;
+  }
+
+  if (!targetOrgId) {
+    // Check user's memberships
+    const { data: memberships } = await supabase
+      .from('organization_memberships')
+      .select('org_id, membership_role')
+      .eq('user_id', user.id);
+
+    if (!memberships || memberships.length === 0) {
+      return NextResponse.json({ error: 'No organization membership found for user', code: 'NO_MEMBERSHIP' }, { status: 403 });
+    }
+    if (memberships.length > 1) {
+      return NextResponse.json({ error: 'Ambiguous organization context. Explicit org_id or hiring_run_id required.', code: 'AMBIGUOUS_ORG' }, { status: 400 });
+    }
+    targetOrgId = memberships[0].org_id;
+  }
+
+  const membership = await getVerifiedOrgMembership(supabase, user.id, targetOrgId);
+  if (!membership || !ALLOWED_EMPLOYER_ROLES.includes(membership.membership_role)) {
+    return NextResponse.json({ error: 'Forbidden: User is not authorized for target organization', code: 'FORBIDDEN' }, { status: 403 });
+  }
+
+  // 4. Compute file SHA-256 and byte size
+  const rawTextContent = typeof content === 'string' ? content : (content ? String(content) : '');
+  const fileSha256 = crypto.createHash('sha256').update(rawTextContent, 'utf-8').digest('hex');
+  const byteSize = Buffer.byteLength(rawTextContent, 'utf-8');
+  const mimeType = source_uri.endsWith('.pdf') ? 'application/pdf' : 'text/plain';
+
+  const cleanUri = source_uri.trim();
+  const workspaceId = `ws_${targetOrgId.slice(0, 8)}`;
+  const artifactId = `storage://context_artifacts/${targetOrgId}/${cleanUri}`;
+  const idempotencyKey = `idemp_${targetOrgId}_${fileSha256}_${Date.now()}`;
+
+  // 5. Call transactional ingestion RPC (or direct database transaction)
+  // Check if RPC exists
+  const { data: rpcData, error: rpcErr } = await supabase.rpc(
+    'ingest_context_source_version_transactional',
+    {
+      p_org_id: targetOrgId,
+      p_workspace_id: workspaceId,
+      p_source_uri: cleanUri,
+      p_source_kind: source_kind,
+      p_file_sha256: fileSha256,
+      p_mime_type: mimeType,
+      p_byte_size: byteSize,
+      p_original_artifact_id: artifactId,
+      p_effective_time: effective_time,
+      p_idempotency_key: idempotencyKey,
+    }
+  );
+
+  let sourceId;
+  let versionId;
+  let versionNumber;
+  let outboxId;
+  let isNewSource = true;
+
+  if (rpcErr || !rpcData || rpcData.length === 0) {
+    // Fallback: direct atomic tables write in case migration is applying
+    // Check if source object exists
+    const { data: existingSource } = await supabase
+      .from('context_source_objects')
+      .select('id')
+      .eq('org_id', targetOrgId)
+      .eq('source_uri', cleanUri)
+      .single();
+
+    if (existingSource) {
+      sourceId = existingSource.id;
+      isNewSource = false;
+      const { data: versions } = await supabase
+        .from('context_source_versions')
+        .select('version_number')
+        .eq('source_id', sourceId)
+        .order('version_number', { ascending: false })
+        .limit(1);
+      versionNumber = (versions?.[0]?.version_number || 0) + 1;
+
+      // Supersede older versions
+      await supabase
+        .from('context_source_versions')
+        .update({ status: 'superseded' })
+        .eq('source_id', sourceId)
+        .in('status', ['pending', 'running', 'completed']);
+    } else {
+      const { data: newSrc, error: srcErr } = await supabase
+        .from('context_source_objects')
+        .insert({
+          org_id: targetOrgId,
+          workspace_id: workspaceId,
+          source_uri: cleanUri,
+          source_kind,
+        })
+        .select('id')
+        .single();
+
+      if (srcErr) throw new Error(srcErr.message);
+      sourceId = newSrc.id;
+      versionNumber = 1;
+    }
+
+    const { data: newVer, error: verErr } = await supabase
+      .from('context_source_versions')
+      .insert({
+        source_id: sourceId,
+        org_id: targetOrgId,
+        version_number: versionNumber,
+        original_artifact_id: artifactId,
+        original_file_sha256: fileSha256,
+        original_mime_type: mimeType,
+        byte_size: byteSize,
+        effective_time,
+        status: 'pending',
+      })
+      .select('id')
+      .single();
+
+    if (verErr) throw new Error(verErr.message);
+    versionId = newVer.id;
+
+    const { data: newOutbox } = await supabase
+      .from('context_transactional_outbox')
+      .insert({
+        org_id: targetOrgId,
+        event_type: 'SOURCE_VERSION_INGESTED',
+        aggregate_type: 'source_version',
+        aggregate_id: versionId,
+        payload: {
+          source_id: sourceId,
+          version_id: versionId,
+          version_number: versionNumber,
+          source_uri: cleanUri,
+          file_sha256: fileSha256,
+          artifact_id: artifactId,
+        },
+        idempotency_key: idempotencyKey,
+        status: 'pending',
+      })
+      .select('id')
+      .single();
+
+    outboxId = newOutbox?.id;
+  } else {
+    sourceId = rpcData[0].source_id;
+    versionId = rpcData[0].version_id;
+    versionNumber = rpcData[0].version_number;
+    outboxId = rpcData[0].outbox_id;
+    isNewSource = rpcData[0].is_new_source;
+  }
+
+  // 6. Execute worker processing for the outbox event
+  if (outboxId) {
+    const outboxEvent = {
+      id: outboxId,
+      org_id: targetOrgId,
+      payload: {
+        source_id: sourceId,
+        version_id: versionId,
+        version_number: versionNumber,
+        artifact_id: artifactId,
+      },
+      attempts: 0,
+      max_attempts: 5,
+    };
+
+    // Execute background worker processing immediately for synchronous readiness
+    await processOutboxEvent(supabase, outboxEvent);
+  }
+
+  return NextResponse.json({
+    ok: true,
+    source_id: sourceId,
+    version_id: versionId,
+    version_number: versionNumber,
+    is_new_source: isNewSource,
+    source_uri: cleanUri,
+    file_sha256: fileSha256,
+    status: 'completed',
+    freshness: versionNumber > 1 ? 'UPDATED_VERSION' : 'INITIAL_VERSION',
+  });
+}
diff --git a/supplied_snapshot/source/apps/web/app/api/employer/research-qa/route.js b/supplied_snapshot/source/apps/web/app/api/employer/research-qa/route.js
new file mode 100644
index 0000000..2c344f2
--- /dev/null
+++ b/supplied_snapshot/source/apps/web/app/api/employer/research-qa/route.js
@@ -0,0 +1,270 @@
+import { NextResponse } from 'next/server';
+import { requireUser, getVerifiedOrgMembership } from '@/lib/serverAuth';
+import {
+  validateEngineConfig,
+  resolveEngineContext,
+  generateDelegatedAuthorizationToken,
+  validateEngineResponse,
+  ALLOWED_MODES,
+} from '@/lib/engineConfig';
+
+const ALLOWED_EMPLOYER_ROLES = ['owner', 'admin', 'recruiter', 'member'];
+
+export async function POST(request) {
+  // 1. Feature Flag Enforcement (Disabled by default)
+  const isFeatureEnabled =
+    process.env.NEXT_PUBLIC_ENABLE_RESEARCH_QA === 'true' ||
+    process.env.ENABLE_RESEARCH_QA === 'true';
+
+  if (!isFeatureEnabled) {
+    return NextResponse.json(
+      {
+        error: 'The Research QA feature is disabled by organization policy.',
+        code: 'RESEARCH_QA_DISABLED',
+        safe_next_action: 'Enable NEXT_PUBLIC_ENABLE_RESEARCH_QA to access document QA.',
+      },
+      { status: 403 }
+    );
+  }
+
+  // 2. Authenticate User via Real Supabase Session
+  const authRes = await requireUser(request);
+  if (authRes.errorResponse) return authRes.errorResponse;
+  const { user, supabase } = authRes;
+
+  // 3. Parse and Validate Request Payload
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return NextResponse.json({ error: 'Invalid JSON payload', code: 'INVALID_JSON' }, { status: 400 });
+  }
+
+  if (!body || typeof body !== 'object' || Array.isArray(body)) {
+    return NextResponse.json({ error: 'Request body must be a valid object', code: 'INVALID_BODY' }, { status: 400 });
+  }
+
+  const { hiring_run_id, role_id, question, mode = 'retrieval_augmented', limit = 5 } = body;
+
+  // Question validation
+  if (!question || typeof question !== 'string' || !question.trim()) {
+    return NextResponse.json({ error: 'Question is required', code: 'QUESTION_REQUIRED' }, { status: 400 });
+  }
+
+  const trimmedQuestion = question.trim();
+  if (trimmedQuestion.length < 3) {
+    return NextResponse.json({ error: 'Question must be at least 3 characters long', code: 'QUESTION_TOO_SHORT' }, { status: 400 });
+  }
+  if (trimmedQuestion.length > 1000) {
+    return NextResponse.json({ error: 'Question exceeds maximum length of 1,000 characters', code: 'QUESTION_TOO_LONG' }, { status: 400 });
+  }
+
+  // Mode validation
+  if (!ALLOWED_MODES.includes(mode)) {
+    return NextResponse.json(
+      { error: `Invalid mode '${mode}'. Allowed: ${ALLOWED_MODES.join(', ')}`, code: 'INVALID_MODE' },
+      { status: 400 }
+    );
+  }
+
+  // Limit validation: Strict integer between 1 and 20 (reject "5junk", 1.9, etc.)
+  if (typeof limit !== 'number' || !Number.isInteger(limit) || limit < 1 || limit > 20) {
+    return NextResponse.json(
+      { error: 'Limit must be a strict integer between 1 and 20', code: 'INVALID_LIMIT' },
+      { status: 400 }
+    );
+  }
+
+  // 4. Strict Workspace Authorization & Server-Owned Mapping (Finding A1)
+  // Require explicit hiring_run_id; never choose memberships[0]
+  if (!hiring_run_id || typeof hiring_run_id !== 'string' || !hiring_run_id.trim()) {
+    return NextResponse.json(
+      {
+        error: 'A valid hiring_run_id is required to resolve authorized organization and corpus context.',
+        code: 'MISSING_HIRING_RUN',
+      },
+      { status: 400 }
+    );
+  }
+
+  // Verify hiring run and organization membership in database
+  const { data: run, error: runErr } = await supabase
+    .from('hiring_runs')
+    .select('id, org_id')
+    .eq('id', hiring_run_id.trim())
+    .single();
+
+  if (runErr || !run) {
+    return NextResponse.json(
+      { error: 'Hiring run not found or access denied', code: 'FORBIDDEN' },
+      { status: 404 }
+    );
+  }
+
+  const membership = await getVerifiedOrgMembership(supabase, user.id, run.org_id);
+  if (!membership || !ALLOWED_EMPLOYER_ROLES.includes(membership.membership_role)) {
+    return NextResponse.json(
+      { error: 'Forbidden: User does not belong to authorized organization', code: 'FORBIDDEN' },
+      { status: 403 }
+    );
+  }
+
+  // Resolve server-owned engine workspace & role mapping
+  const contextRes = resolveEngineContext(run.org_id, run.id, role_id || null);
+  if (!contextRes.ok) {
+    return NextResponse.json(
+      { error: contextRes.message, code: contextRes.code },
+      { status: contextRes.status }
+    );
+  }
+
+  // 5. Configuration Validation — Must Fail Closed (Finding A2)
+  const configRes = validateEngineConfig();
+  if (!configRes.ok) {
+    return NextResponse.json(
+      { error: configRes.message, code: configRes.code },
+      { status: configRes.status }
+    );
+  }
+
+  const { engineBaseUrl, engineServiceKey } = configRes;
+  const { workspaceId, roleId, companyName, corpusScope } = contextRes;
+
+  // 6. Engine-Side Delegated Authorization (Finding A2)
+  // Issue HMAC-SHA256 signed bearer token binding actor, org, run, workspace, role, and op
+  const delegatedToken = generateDelegatedAuthorizationToken({
+    actorId: user.id,
+    actorEmail: user.email,
+    orgId: run.org_id,
+    hiringRunId: run.id,
+    workspaceId,
+    roleId,
+    operation: mode === 'retrieval_only' ? 'retrieve' : 'research_qa',
+    secretKey: engineServiceKey,
+    ttlSeconds: 300,
+  });
+
+  // 7. Scoped Server-to-Server Request with 30s Timeout Protection (Finding A4)
+  const controller = new AbortController();
+  const timeoutId = setTimeout(() => controller.abort(), 30000);
+
+  try {
+    const engineRes = await fetch(
+      `${engineBaseUrl}/v1/workspaces/${encodeURIComponent(workspaceId)}/research-qa`,
+      {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+          'Authorization': `Bearer ${engineServiceKey}`,
+          'X-Delegated-Authorization': `Bearer ${delegatedToken}`,
+        },
+        body: JSON.stringify({
+          question: trimmedQuestion,
+          mode,
+          limit,
+          role_id: roleId,
+        }),
+        signal: controller.signal,
+      }
+    );
+
+    // Authentication failure on upstream engine
+    if (engineRes.status === 401 || engineRes.status === 403) {
+      clearTimeout(timeoutId);
+      return NextResponse.json(
+        { error: 'Internal service or delegated authorization failure', code: 'ENGINE_AUTH_ERROR' },
+        { status: 502 }
+      );
+    }
+
+    // Workspace not found upstream
+    if (engineRes.status === 404) {
+      clearTimeout(timeoutId);
+      return NextResponse.json(
+        { error: 'Research workspace not found in engine', code: 'WORKSPACE_NOT_FOUND' },
+        { status: 404 }
+      );
+    }
+
+    // Upstream engine error response
+    if (!engineRes.ok) {
+      clearTimeout(timeoutId);
+      const errData = await engineRes.json().catch(() => ({}));
+      const detailStr = String(errData.detail || errData.error || '');
+
+      // Check if upstream provider call was blocked due to missing/unprovisioned key
+      if (
+        detailStr.includes('GEMINI_API_KEY environment variable is not set') ||
+        detailStr.includes('provider credential') ||
+        detailStr.includes('BLOCKED_PENDING_KEY_ROTATION')
+      ) {
+        return NextResponse.json(
+          {
+            error: 'Provider credential unconfigured. Live generation is BLOCKED pending key configuration.',
+            code: 'BLOCKED_PENDING_KEY_ROTATION',
+            status: 'INSUFFICIENT_EVIDENCE',
+            disclaimer:
+              corpusScope === 'PUBLIC_RESEARCH'
+                ? 'PUBLIC RESEARCH / NOT EMPLOYER-APPROVED. Live provider calls are blocked pending key configuration.'
+                : 'CONFIDENTIAL TENANT CORPUS / NOT EMPLOYER-APPROVED. Live provider calls are blocked pending key configuration.',
+            citations: [],
+            execution_provenance: 'BLOCKED_PENDING_KEY_ROTATION',
+          },
+          { status: 503 }
+        );
+      }
+
+      return NextResponse.json(
+        { error: errData.detail || 'Context engine execution failed', code: 'ENGINE_ERROR' },
+        { status: engineRes.status }
+      );
+    }
+
+    const rawEngineData = await engineRes.json();
+    clearTimeout(timeoutId);
+
+    // 8. Strict Discriminated Response Contract Validation (Finding A3)
+    const validationRes = validateEngineResponse(rawEngineData, mode);
+    if (!validationRes.ok) {
+      return NextResponse.json(
+        { error: validationRes.message, code: validationRes.code },
+        { status: validationRes.status }
+      );
+    }
+
+    const validatedData = validationRes.data;
+
+    // 9. Return Sanitized Payload with Company, Scope & Mode Context (Finding A5)
+    return NextResponse.json({
+      mode: validatedData.mode,
+      answer: validatedData.answer,
+      status: validatedData.status,
+      company_name: companyName,
+      role_id: roleId,
+      corpus_scope: corpusScope,
+      disclaimer:
+        corpusScope === 'PUBLIC_RESEARCH'
+          ? 'PUBLIC RESEARCH / NOT EMPLOYER-APPROVED. This information is derived from indexed reference documents for recruiter context only. It does not establish candidate competence or modify hiring rubrics.'
+          : 'CONFIDENTIAL TENANT CORPUS / NOT EMPLOYER-APPROVED. This information is retrieved from private tenant documents. It does not establish candidate competence or modify hiring rubrics.',
+      citations: validatedData.citations,
+      passages: validatedData.passages || [],
+      retrieved_count: validatedData.retrieved_count || (validatedData.citations ? validatedData.citations.length : 0),
+      has_validation_errors: validatedData.has_validation_errors,
+      latency_ms: validatedData.latency_ms,
+      execution_provenance: validatedData.execution_provenance,
+      diagnostics: validatedData.diagnostics || [],
+    });
+  } catch (err) {
+    clearTimeout(timeoutId);
+    if (err.name === 'AbortError') {
+      return NextResponse.json(
+        { error: 'Research QA request timed out after 30 seconds', code: 'GATEWAY_TIMEOUT' },
+        { status: 504 }
+      );
+    }
+    return NextResponse.json(
+      { error: 'Context engine service temporarily unavailable', code: 'SERVICE_UNAVAILABLE' },
+      { status: 503 }
+    );
+  }
+}
