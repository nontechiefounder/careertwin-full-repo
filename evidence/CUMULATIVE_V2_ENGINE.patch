+"""One durable workflow per immutable version. No source text in workflow history."""
+from datetime import timedelta
+from temporalio import activity, workflow
+from temporalio.common import RetryPolicy, WorkflowIDReusePolicy
+from temporalio.exceptions import ApplicationError, WorkflowAlreadyStartedError
+
+with workflow.unsafe.imports_passed_through():
+    import time
+    from sqlalchemy import select, and_, or_
+    from .core import Job, Version, uid
+
+@workflow.defn
+class EvidenceVersionWorkflow:
+    @workflow.run
+    async def run(self, version_id: str) -> dict:
+        result=await workflow.execute_activity('process_evidence_version',version_id,
+            start_to_close_timeout=timedelta(seconds=150),
+            retry_policy=RetryPolicy(initial_interval=timedelta(seconds=60),maximum_attempts=5))
+        await workflow.execute_activity('index_evidence_version',version_id,
+            start_to_close_timeout=timedelta(minutes=5),
+            retry_policy=RetryPolicy(maximum_attempts=3))
+        projection=await workflow.execute_activity('project_evidence_version',version_id,
+            start_to_close_timeout=timedelta(minutes=5),
+            retry_policy=RetryPolicy(maximum_attempts=1))
+        return result | {'graph_projection':projection['status']}
+
+class EvidenceActivities:
+    def __init__(self,kernel,hybrid=None,graph=None):
+        self.kernel,self.hybrid,self.graph=kernel,hybrid,graph
+
+    @activity.defn(name='process_evidence_version')
+    def process_version(self,version_id: str) -> dict:
+        now=time.time()
+        with self.kernel.session.begin() as db:
+            job=db.scalar(select(Job).where(Job.version==version_id).with_for_update())
+            if not job:
+                raise ApplicationError('VERSION_JOB_NOT_FOUND',non_retryable=True)
+            if job.state=='completed':
+                return {'ok':True,'state':db.get(Version,version_id).state,'replayed':True}
+            if job.state=='failed' or job.attempts>=5:
+                job.state='failed'
+                db.get(Version,version_id).state='failed'
+                terminal=True
+            else:
+                terminal=False
+                if job.state=='processing' and job.lease_until>=now:
+                    raise ApplicationError('LEASE_BUSY')
+                job.state,job.fence,job.lease_until='processing',uid(),now+140
+                job.attempts+=1
+                claim=(job.id,job.fence)
+        if terminal:
+            raise ApplicationError('RETRY_EXHAUSTED',non_retryable=True)
+        result=self.kernel.process(claim)
+        if not result['ok']:
+            raise ApplicationError(result['code'],non_retryable=result['code'] in ('ORIGINAL_HASH_MISMATCH','SOURCE_DELETED'))
+        return result
+
+    @activity.defn(name='index_evidence_version')
+    def index_version(self,version_id: str) -> dict:
+        if self.hybrid is None:
+            return {'status':'LEXICAL_ONLY','reason':'EMBEDDING_PROVIDER_NOT_CONFIGURED'}
+        return self.hybrid.index_version(version_id)
+
+    @activity.defn(name='project_evidence_version')
+    async def project_version(self,version_id: str) -> dict:
+        if self.graph is None:
+            return {'status':'NOT_ENABLED'}
+        # Automatic retries disabled until native Graphiti replay/duplicate-cost
+        # acceptance is complete; failure is visible in the workflow, never hidden.
+        return await self.graph.project_version(version_id)
+
+async def dispatch_pending(kernel,client,queue='wbctx-evidence'):
+    """Replay-safe poll of the existing committed job table; no second outbox."""
+    with kernel.session() as db:
+        pending=db.scalars(select(Job.version).where(Job.state.in_(('pending','processing')))).all()
+    started=0
+    for version in pending:
+        try:
+            await client.start_workflow(EvidenceVersionWorkflow.run,version,
+                id='wbctx-version-'+version,task_queue=queue,
+                id_reuse_policy=WorkflowIDReusePolicy.REJECT_DUPLICATE)
+            started+=1
+        except WorkflowAlreadyStartedError:
+            pass
+    return started
