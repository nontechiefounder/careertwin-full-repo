+"""Graphiti is a derived index. Authorize and re-resolve all episode candidates."""
+import hashlib
+import json
+import uuid
+from datetime import datetime, timezone
+from graphiti_core.nodes import EpisodeType
+from sqlalchemy import select
+from .core import Source, Version, Fault
+
+
+def namespace(claims):
+    scope = [claims[k] for k in ('org','run','workspace','role')]
+    if any(not isinstance(v,str) or not v.strip() for v in scope):
+        raise Fault(403,'INVALID_GRAPH_SCOPE')
+    return 'wbctx_' + hashlib.sha256(json.dumps(scope).encode()).hexdigest()
+
+
+def episode_id(version_id):
+    return str(uuid.uuid5(uuid.NAMESPACE_URL,'workbyline-context-version:'+version_id))
+
+
+def allowed_versions(kernel, claims, as_of=None):
+    # Source of truth consulted at READ time, including deletion/supersession.
+    with kernel.session() as db:
+        ids=db.scalars(select(Source.id).where(*kernel._scope(claims),Source.deleted.is_(False))).all()
+    result={}
+    for source_id in ids:
+        try:
+            doc=kernel.inspect(claims,source_id,as_of)
+        except Fault:
+            continue
+        if doc['state'] in ('completed','partial'):
+            result[episode_id(doc['version_id'])]=doc
+    return result
+
+
+class GraphProjection:
+    def __init__(self,kernel,client):
+        # Inject an explicitly configured Graphiti SDK instance. No implicit API key.
+        self.kernel,self.client=kernel,client
+
+    async def project_version(self,version_id):
+        with self.kernel.session() as db:
+            ver=db.get(Version,version_id)
+            if not ver:
+                raise Fault(404,'VERSION_NOT_FOUND')
+            source=db.get(Source,ver.source)
+            claims={k:getattr(source,k) for k in ('org','run','workspace','role')}
+            source_id=source.id
+        doc=self.kernel.inspect(claims,source_id)
+        if doc['version_id']!=version_id or doc['state'] not in ('completed','partial'):
+            return {'status':'SKIPPED_NOT_CURRENT_COMPLETE'}
+        # Immutable deterministic UUID is passed to Graphiti; native replay needs
+        # live acceptance before automatic projection retries may be enabled.
+        body=json.dumps({'source_id':source_id,'version_id':version_id,
+                         'spans':doc['spans'],'approval':'NOT_OBTAINED'})
+        if len(body)>32000:
+            raise Fault(413,'GRAPH_CONTEXT_BUDGET_EXCEEDED')
+        await self.client.add_episode(name='Evidence '+version_id,
+            episode_body=body,
+            source_description='WorkByLine immutable source version; derived extraction, not verified truth',
+            reference_time=datetime.fromtimestamp(doc['observed_at'],timezone.utc),
+            source=EpisodeType.json,group_id=namespace(claims),uuid=episode_id(version_id))
+        return {'status':'PROJECTED','episode_id':episode_id(version_id)}
+
+    async def candidate_versions(self,claims,query,as_of=None):
+        allowed=allowed_versions(self.kernel,claims,as_of)
+        edges=await self.client.search(query=query,group_ids=[namespace(claims)],num_results=20)
+        selected={}
+        for edge in edges:
+            if edge.group_id != namespace(claims):
+                continue
+            provenance=set(edge.episodes or [])
+            # Mixed stale/private provenance cannot influence active results.
+            if not provenance or not provenance.issubset(allowed):
+                continue
+            for eid in provenance:
+                selected[eid]=allowed[eid]
+        # Recheck on return: a source may have been revoked during graph I/O.
+        still_allowed=allowed_versions(self.kernel,claims,as_of)
+        return [doc for eid,doc in selected.items() if eid in still_allowed]
diff --git a/service/hybrid.py b/service/hybrid.py
new file mode 100644
index 0000000..ba5157f
--- /dev/null
+++ b/service/hybrid.py
@@ -0,0 +1,84 @@
+"""Scoped PostgreSQL FTS + pgvector, exact search then reciprocal rank fusion."""
+import math
+from sqlalchemy import text
+from .core import Fault
+
+DIMENSIONS = 384
+
+def vector_literal(values):
+    if len(values) != DIMENSIONS or any(isinstance(v, bool) or not isinstance(v, (float,int)) or not math.isfinite(v) for v in values):
+        raise Fault(422, 'INVALID_EMBEDDING')
+    if not any(values):
+        raise Fault(422, 'ZERO_EMBEDDING')
+    return '[' + ','.join(str(float(v)) for v in values) + ']'
+
+# Choose the latest observed version BEFORE checking processing state, so pending
+# revisions cannot silently fall back to an old complete document.
+ELIGIBLE = '''WITH latest AS (
+ SELECT DISTINCT ON (s.id) s.id source_id,v.id version_id,v.state
+ FROM wbctx_sources s JOIN wbctx_versions v ON v.source=s.id
+ WHERE s.org=:org AND s.run=:run AND s.workspace=:workspace AND s.role=:role
+ AND s.deleted=false AND (CAST(:as_of AS double precision) IS NULL OR v.observed_at<=CAST(:as_of AS double precision))
+ ORDER BY s.id,v.number DESC
+), allowed AS (
+ SELECT p.id span_id,p.text,p.start,p."end",p.page,l.source_id,l.version_id
+ FROM latest l JOIN wbctx_spans p ON p.version=l.version_id
+ WHERE l.state IN ('completed','partial')
+) '''
+LEXICAL = ELIGIBLE + '''SELECT a.*, ts_rank_cd(to_tsvector('english',a.text),websearch_to_tsquery('english',:query)) score
+ FROM allowed a WHERE to_tsvector('english',a.text) @@ websearch_to_tsquery('english',:query)
+ ORDER BY score DESC,span_id LIMIT 50'''
+DENSE = ELIGIBLE + '''SELECT a.*,e.embedding <=> CAST(:vector AS vector) distance
+ FROM allowed a JOIN wbctx_span_embeddings e ON e.span_id=a.span_id
+ WHERE e.model_id=:model ORDER BY distance,span_id LIMIT 50'''
+
+class HybridRetriever:
+    def __init__(self, kernel, model_id, embed=None):
+        if kernel.engine.dialect.name != 'postgresql':
+            raise Fault(503, 'POSTGRES_REQUIRED_FOR_HYBRID')
+        if not model_id.strip():
+            raise Fault(503, 'EMBEDDING_MODEL_REQUIRED')
+        self.kernel, self.model_id, self.embed = kernel, model_id, embed
+
+    def index_version(self, version_id):
+        if self.embed is None:
+            raise Fault(503, 'EMBEDDING_PROVIDER_UNAVAILABLE')
+        from sqlalchemy import select
+        from .core import Span, Version
+        with self.kernel.session() as db:
+            ver = db.get(Version, version_id)
+            if not ver or ver.state not in ('completed','partial'):
+                raise Fault(409, 'VERSION_NOT_INDEXABLE')
+            spans = db.scalars(select(Span).where(Span.version==version_id)).all()
+            payloads = [(s.id, vector_literal(self.embed(s.text))) for s in spans]
+        with self.kernel.engine.begin() as conn:
+            for span_id, vector in payloads:
+                conn.execute(text('''INSERT INTO wbctx_span_embeddings(span_id,model_id,embedding)
+                  VALUES (:span,:model,CAST(:vector AS vector)) ON CONFLICT(span_id)
+                  DO UPDATE SET model_id=excluded.model_id,embedding=excluded.embedding'''),
+                  {'span':span_id,'model':self.model_id,'vector':vector})
+        return {'indexed_spans':len(payloads),'model_id':self.model_id}
+
+    def retrieve(self, claims, query, limit=5, as_of=None):
+        if not 1 <= limit <= 20:
+            raise Fault(422, 'INVALID_LIMIT')
+        params = {k: claims[k] for k in ('org','run','workspace','role')}
+        params.update(query=query,as_of=as_of,model=self.model_id)
+        with self.kernel.engine.connect() as conn:
+            lexical = [dict(x) for x in conn.execute(text(LEXICAL),params).mappings()]
+            dense = []
+            if self.embed is not None:
+                params['vector']=vector_literal(self.embed(query))
+                dense=[dict(x) for x in conn.execute(text(DENSE),params).mappings()]
+        merged={}
+        for ranking in (lexical,dense):
+            for rank,row in enumerate(ranking,1):
+                item=merged.setdefault(row['span_id'],{k:v for k,v in row.items() if k not in ('score','distance')})
+                item['rrf_score']=item.get('rrf_score',0)+1/(60+rank)
+                item['employer_approval']='NOT_OBTAINED'
+        return {'mode':'retrieval_only','status':'RETRIEVAL_ONLY_COMPLETE','answer':None,
+                'passages':sorted(merged.values(),key=lambda r:(-r['rrf_score'],r['span_id']))[:limit],
+                'retrieval_method':'postgres-fts+pgvector-rrf' if self.embed else 'postgres-fts',
+                'dense_enabled':self.embed is not None,
+                'has_validation_errors': False,
+                'disclaimer':'SOURCE MATERIAL / NOT EMPLOYER-APPROVED; retrieval does not verify competence'}
