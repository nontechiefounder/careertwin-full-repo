+
+    with kernel.session.begin() as db:
+        db.add(Binding(**claims, active=True, can_write=True))
+
+    # 2. Ingestion Throughput Measurement
+    print("--- 2. End-to-End Ingestion Throughput Evaluation ---")
+    num_docs = 100
+
+    # 2a. TXT Workload
