+
+function expectStatus(actual, allowed) {
+  if (!allowed.includes(actual)) {
+    throw new Error(`Expected HTTP status ${allowed.join(' or ')}, got ${actual}`);
+  }
+}
+
+main().catch(err => {
+  console.error('[FATAL]', err);
+  process.exit(1);
