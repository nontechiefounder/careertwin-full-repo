+#!/usr/bin/env bash
+# ==============================================================================
+# WorkByLine V2 — Unified Database Target Safety Guard (Bash)
+# Enforces strict fail-closed rejection of the protected baseline database:
+#   - Container: supabase_db_careertwin-local-baseline (case-insensitive)
+#   - Port: 54332 (URL host:port, query ?port=54332, libpq "port = 54332")
+#   - Supported formats: URLs, SQLAlchemy URLs, libpq key-value, disposable containers
+#   - Rejects malformed / unsupported formats
+#   - Argument-array subprocess execution (no shell interpolation)
+#   - Zero credential leakage in logging
+# ==============================================================================
+
+# Safe Target Redaction: Extracts safe host/port/db/user identity without credentials
+mask_target_identity() {
+  local raw="$1"
+  if [ -z "${raw}" ]; then
+    echo "none"
+    return
+  fi
+
+  local lower="$(echo "${raw}" | tr '[:upper:]' '[:lower:]')"
+
+  # Handle URLs (postgres://, postgresql://, postgresql+psycopg://, etc.)
+  if [[ "${lower}" =~ ^[a-z0-9\+]+:// ]]; then
+    local no_proto="${raw#*://}"
+    local auth_part=""
+    local host_part=""
+    local user="unknown"
+    local host="localhost"
+    local port="5432"
+    local db="postgres"
+
+    if [[ "${no_proto}" =~ @ ]]; then
+      auth_part="${no_proto%@*}"
+      host_part="${no_proto##*@}"
+      user="${auth_part%%:*}"
+    else
+      host_part="${no_proto}"
+    fi
+
+    # Parse host_part: host[:port][/dbname[?query]]
+    local hp_no_query="${host_part%%\?*}"
+    local path_part=""
+    if [[ "${hp_no_query}" =~ / ]]; then
+      path_part="${hp_no_query#*/}"
+      hp_no_query="${hp_no_query%%/*}"
+      db="${path_part%%#*}"
+    fi
+
+    if [[ "${hp_no_query}" =~ : ]]; then
+      host="${hp_no_query%%:*}"
+      port="${hp_no_query##*:}"
+    else
+      host="${hp_no_query}"
+    fi
+
+    echo "host: ${host}, port: ${port}, db: ${db}, user: ${user}"
+    return
+  fi
+
+  # Handle libpq key-value strings (e.g. host=127.0.0.1 port=54399 user=postgres dbname=postgres)
+  if [[ "${raw}" =~ [a-zA-Z_]+[[:space:]]*= ]]; then
+    local host="localhost"
+    local port="5432"
+    local db="postgres"
+    local user="unknown"
+
+    if [[ "${raw}" =~ host[[:space:]]*=[[:space:]]*[\'\"]?([^[:space:]\'\"]+) ]]; then
+      host="${BASH_REMATCH[1]}"
+    fi
+    if [[ "${raw}" =~ port[[:space:]]*=[[:space:]]*[\'\"]?([^[:space:]\'\"]+) ]]; then
+      port="${BASH_REMATCH[1]}"
+    fi
+    if [[ "${raw}" =~ dbname[[:space:]]*=[[:space:]]*[\'\"]?([^[:space:]\'\"]+) ]]; then
+      db="${BASH_REMATCH[1]}"
+    fi
+    if [[ "${raw}" =~ user[[:space:]]*=[[:space:]]*[\'\"]?([^[:space:]\'\"]+) ]]; then
+      user="${BASH_REMATCH[1]}"
+    fi
+
+    echo "host: ${host}, port: ${port}, db: ${db}, user: ${user} (libpq)"
+    return
+  fi
+
+  # Handle container names
+  echo "container: ${raw}"
+}
+
+# Strict target validation function: Exits with code 42 upon any protected match
+assert_disposable_target() {
+  local target_val="$1"
+
+  if [ -z "${target_val:-}" ]; then
+    echo "[SECURITY REJECTION] No database target configured. Explicit disposable target required." >&2
+    exit 42
+  fi
+
+  local lower_val="$(echo "${target_val}" | tr '[:upper:]' '[:lower:]')"
+
+  # 1. Container Rejection (case-insensitive substring match)
+  if [[ "${lower_val}" =~ supabase_db_careertwin-local-baseline ]] || [[ "${lower_val}" =~ careertwin-local-baseline ]]; then
+    echo "[SECURITY REJECTION] Target matches protected shared baseline database identity (supabase_db_careertwin-local-baseline)." >&2
+    echo "[SECURITY REJECTION] Refusing mutation. Zero writes permitted to protected baseline database." >&2
+    exit 42
+  fi
+
+  # 2. Port 54332 Rejection across all connection representations:
+  #    - URL host:port (e.g. :54332)
+  #    - libpq key-value (e.g. port=54332, port = 54332, port='54332')
+  #    - URL query parameters (e.g. ?port=54332 or &port=54332)
+  if [[ "${lower_val}" =~ :54332(/|$|\?) ]] || \
+     [[ "${lower_val}" =~ [[:space:]]port[[:space:]]*=[[:space:]]*[\'\"]?54332 ]] || \
+     [[ "${lower_val}" =~ ^port[[:space:]]*=[[:space:]]*[\'\"]?54332 ]] || \
