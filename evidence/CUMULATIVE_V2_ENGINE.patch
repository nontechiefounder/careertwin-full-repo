+
+def test_failure_before_commit_is_atomic_and_retryable(kernel):
+    k = kernel
+    with TestClient(create_app(k)) as client:
+        obj = put(client, k).json()
+        first = k.claim()
+        assert not k.process(first, fail_before_commit=True)["ok"]
