+"use client";
+import { useEffect, useState, useRef } from 'react';
+import api from '@/lib/api';
+import {
+  FileText,
+  Upload,
+  RefreshCw,
+  Search,
+  Share2,
+  AlertCircle,
+  CheckCircle2,
+  Clock,
+  ChevronRight,
+  ShieldAlert,
+  Info
+} from 'lucide-react';
+
+export default function ContextEvidencePanel({ hiringRunId, orgId }) {
+  const [sources, setSources] = useState([]);
+  const [selected, setSelected] = useState(null);
+  const [file, setFile] = useState(null);
+  const [sourceKey, setSourceKey] = useState('');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [question, setQuestion] = useState('');
+  const [result, setResult] = useState(null);
+  const [retrievalMode, setRetrievalMode] = useState('search');
+
+  const fileInputRef = useRef(null);
+  const activeRunRef = useRef(hiringRunId);
+  const abortControllersRef = useRef(new Set());
+
+  // Helper to register abort controller
+  const createController = () => {
+    const controller = new AbortController();
+    abortControllersRef.current.add(controller);
+    return controller;
+  };
+
+  const removeController = (controller) => {
+    abortControllersRef.current.delete(controller);
+  };
+
+  // Cancel all in-flight requests
+  const abortAllInFlight = () => {
+    abortControllersRef.current.forEach((c) => {
+      try { c.abort(); } catch (_) {}
+    });
+    abortControllersRef.current.clear();
+  };
+
+  // Safe refresh ensuring run isolation
