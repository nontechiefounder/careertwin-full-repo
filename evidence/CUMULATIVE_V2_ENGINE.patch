+    FOR INSERT TO authenticated
+    WITH CHECK (
+        security.has_org_role(organization_id, ARRAY['owner'])
+        OR (security.has_org_role(organization_id, ARRAY['admin']) AND membership_role != 'owner')
+        OR (user_id = auth.uid() AND membership_role = 'owner')
