index 0000000..7ef6564
--- /dev/null
+++ b/apps/web/app/api/employer/context-sources/[sourceId]/evidence/route.js
@@ -0,0 +1,12 @@
+import { NextResponse } from 'next/server';
+import { contextScope, contextFetch } from '@/lib/contextClient';
+function errorResponse(error) { return NextResponse.json({error: error.code || 'CONTEXT_UNAVAILABLE'}, {status: error.status || 503}); }
+export async function GET(request, {params}) {
+  try {
+    const scope = await contextScope(request, new URL(request.url).searchParams.get('hiring_run_id'));
+    if (scope.errorResponse) return scope.errorResponse;
+    const {sourceId} = await params;
+    const result = await contextFetch(scope, `/sources/${encodeURIComponent(sourceId)}`);
+    return NextResponse.json(result.body, {status:result.status});
+  } catch(error) { return errorResponse(error); }
+}
diff --git a/apps/web/app/api/employer/context-sources/related/route.js b/apps/web/app/api/employer/context-sources/related/route.js
new file mode 100644
index 0000000..ccb9027
--- /dev/null
+++ b/apps/web/app/api/employer/context-sources/related/route.js
@@ -0,0 +1,15 @@
+import { NextResponse } from 'next/server';
+import { contextScope, contextFetch } from '@/lib/contextClient';
+export async function POST(request) {
+  try {
+    const body=await request.json();
+    if (!body || typeof body.question!=='string' || body.question.trim().length<3 || body.question.length>1000)
+      return NextResponse.json({error:'INVALID_QUESTION'},{status:400});
+    if (['org_id','workspace_id','role_id'].some(k=>k in body))
+      return NextResponse.json({error:'CLIENT_SCOPE_OVERRIDE'},{status:400});
+    const scope=await contextScope(request,body.hiring_run_id,'retrieve');
+    if(scope.errorResponse)return scope.errorResponse;
+    const res=await contextFetch(scope,'/related-evidence',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question:body.question.trim(),limit:5})});
+    return NextResponse.json(res.body,{status:res.status});
+  } catch(e){return NextResponse.json({error:e.code||'CONTEXT_UNAVAILABLE'},{status:e.status||503});}
+}
