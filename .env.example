# ==============================================================================
# CareerTWiN Monorepo Root Environment Variable Template
# ==============================================================================
# IMPORTANT: Variable names only with BLANK values (or safety defaults).
# NEVER place secret keys, passwords, or live customer tokens in this file.

# Supabase Authentication & Database Services
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Staging Environment Verification Configuration
CAREERTWIN_STAGING_SUPABASE_URL=
CAREERTWIN_STAGING_PUBLISHABLE_KEY=
CAREERTWIN_STAGING_TEST_PASSWORD=

# Safety Gate: Email Dry Run (MANDATORY FOR NON-PRODUCTION ENVIRONMENTS)
CAREERTWIN_DRY_RUN_EMAIL=true

# Application Core Configuration
PORT=3000
NODE_ENV=production
PUBLIC_APP_URL=http://localhost:3000

# Storage & Object Management
STORAGE_BUCKET_NAME=candidate_resumes

# Model Provider Integration Gateway (External calls gated; leave blank unless explicitly authorized)
GEMINI_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Provider selection: preference ordering by default ('groq' | 'gemini' | 'claude' | 'openai')
WORKBYLINE_AI_PROVIDER=
# Set to 'true' to strictly restrict generation to WORKBYLINE_AI_PROVIDER with zero fallback
WORKBYLINE_AI_STRICT_PROVIDER=false

# Sourcing & ATS External Integrations (Fail closed when absent; never enable synthetic_sandbox in production)
CRUSTDATA_API_KEY=
CRUSTDATA_AUTH_TOKEN=
DATAVERTEX_API_KEY=
DATAVERTEX_MAX_CREDITS=2
CORESIGNAL_API_KEY=
ASHBY_API_KEY=

# External Email & OAuth Integrations (Strictly suppressed when CAREERTWIN_DRY_RUN_EMAIL=true)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SYSTEM_EMAIL_HOST=
SYSTEM_EMAIL_PORT=
SYSTEM_EMAIL_USER=
SYSTEM_EMAIL_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_OAUTH_STATE_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Context Engine Integration (Research QA Proxy)
NEXT_PUBLIC_ENABLE_RESEARCH_QA=false
ENABLE_RESEARCH_QA=false
WORKBYLINE_ENGINE_URL=http://127.0.0.1:8000
WORKBYLINE_INTERNAL_SERVICE_KEY=
WORKBYLINE_RESEARCH_WORKSPACE_ID=
MOCK_RESEARCH_QA_PROVIDER=false

# Context Evidence & Four-Layer Memory Expansion (Temporal, LangGraph, pgvector, Graphiti)
WORKBYLINE_CONTEXT_DATABASE_URL=
WORKBYLINE_CONTEXT_STORAGE=./private-context-storage
WORKBYLINE_CONTEXT_DELEGATION_SECRET=
WORKBYLINE_CONTEXT_SERVICE_URL=http://127.0.0.1:8011
WORKBYLINE_ENGINE_MAPPINGS=
TEMPORAL_ADDRESS=127.0.0.1:7233
WORKBYLINE_GENERATION_GATE=false

# Vector Embeddings (pgvector: exact 384 dimensions; model/version explicit)
WORKBYLINE_EMBEDDING_MODEL=bge-small-en-v1.5
WORKBYLINE_EMBEDDING_REVISION=v1.5
WORKBYLINE_EMBEDDING_WEIGHTS=
WORKBYLINE_EMBEDDING_CONFIG_SHA256=

# Graphiti Configuration (Separately gated; disabled by default)
WORKBYLINE_GRAPH_ENABLED=false
GRAPHITI_TELEMETRY_ENABLED=false
LANGSMITH_TRACING=false
WORKBYLINE_GRAPH_URI=bolt://127.0.0.1:7687
WORKBYLINE_GRAPH_USER=
WORKBYLINE_GRAPH_PASSWORD=
WORKBYLINE_GRAPH_LLM_MODEL=
WORKBYLINE_GRAPH_EMBEDDING_MODEL=

# Disposable Testing & Rollback Target Verification (Never use production or port 54332)
DISPOSABLE_DATABASE_URL=
DISPOSABLE_SUPABASE_URL=
DISPOSABLE_SUPABASE_ANON_KEY=
DISPOSABLE_SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# CONSOLIDATED EXTERNAL PROVIDER PREREQUISITE MATRIX
# ==============================================================================
# All external hosted providers fail closed unless explicitly provisioned.
# In production/acceptance, zero dummy or mock fallbacks are permitted.
#
# Provider    | Feature / Capability         | Required Environment Variables                                                | Default Status     | Fail-Closed Behavior
# ------------|------------------------------|-------------------------------------------------------------------------------|--------------------|--------------------------------------------
# Gemini API  | Generative Synthesis / QA    | GEMINI_API_KEY, WORKBYLINE_GENERATION_GATE=true                               | GATED / DEFERRED   | HTTP 503 BLOCKED_PENDING_KEY_ROTATION / FEATURE_GATED_GENERATION
# FalkorDB /  | Graphiti Knowledge Graph     | WORKBYLINE_GRAPH_ENABLED=true, WORKBYLINE_GRAPH_URI, WORKBYLINE_GRAPH_USER,  | GATED / DEFERRED   | HTTP 503 GRAPH_PROJECTION_UNAVAILABLE
# Neo4j       | Entity / Temporal Projections| WORKBYLINE_GRAPH_PASSWORD, WORKBYLINE_GRAPH_LLM_MODEL, WORKBYLINE_GRAPH_EMBED |                    |
# OpenFGA     | Fine-grained Authorization   | (Scope ON HOLD per founder closeout boundaries)                               | ON HOLD            | Hard boundary (native PostgreSQL RBAC used)
# Nango       | Unified External Auth Sync    | (Scope ON HOLD per founder closeout boundaries)                               | ON HOLD            | Hard boundary (isolated token delegation)
# MinerU      | Deep OCR / Layout Analysis    | (Scope ON HOLD per founder closeout boundaries)                               | ON HOLD            | Hard boundary (PyMuPDF + python-docx used)
# ==============================================================================

